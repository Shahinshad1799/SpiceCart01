<script>
  function toggleProfileMenu(event) {
    event.stopPropagation();

    const dropdown = document.getElementById("profileDropdown");

    if (!dropdown) return;

    dropdown.classList.toggle("hidden");
  }

  document.addEventListener("click", function (event) {
    const dropdown = document.getElementById("profileDropdown");

    if (!dropdown) return;

    // If click is outside dropdown, close it
    if (!dropdown.contains(event.target)) {
      dropdown.classList.add("hidden");
    }
  });

  function setBadge(el, count) {
    if (!el) return;

    if (count > 0) {
      el.textContent = count > 99 ? "99+" : count;
      el.classList.remove("hidden");
      el.classList.add("flex");
    } else {
      el.classList.add("hidden");
      el.classList.remove("flex");
    }
  }

  window.updateWishCount = function (count) {
    setBadge(document.getElementById("wishCountBadge"), count);
  };

  window.updateCartCount = function (count) {
    setBadge(document.getElementById("cartCountBadge"), count);
  };

  window.spiceCartRequest = async function (url, method = "POST", body = null) {
    try {
      const res = await fetch(url, {
        method,
        headers: {
          "Content-Type": "application/json"
        },
        body: body ? JSON.stringify(body) : null
      });

      const data = await res.json();

      if (typeof data.cartCount !== "undefined") {
        window.updateCartCount(data.cartCount);
      }

      if (typeof data.wishCount !== "undefined") {
        window.updateWishCount(data.wishCount);
      }

      return data;

    } catch (err) {
      console.error("SpiceCart request failed:", err);

      Swal.fire(
        "Oops",
        "Something went wrong. Please try again.",
        "error"
      );

      return null;
    }
  };
</script>