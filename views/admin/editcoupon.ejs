<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>SpiceCart Admin - Edit Coupon</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#F97316", // Vibrant Orange
                        "primary-dark": "#EA580C",
                        "saffron": "#FF9933",
                        "background-light": "#FDFCFB",
                        "background-dark": "#131f1b",
                        "sidebar-orange": "#F97316",
                        "active-green": "#16a34a",
                        "inactive-red": "#dc2626",
                        "block-red": "#dc2626",
                        "unblock-green": "#16a34a"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    body { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181610] dark:text-white min-h-screen flex">

  <%- include("../partials/sidebar") %>

  <main class="flex-1 flex flex-col">
    <div class="max-w-7xl mx-auto p-8 lg:p-12 w-full">

      <!-- Back Link -->
      <a href="/admin/coupons" class="inline-flex items-center gap-1 text-sm font-semibold text-[#8d7c5e] hover:text-primary transition-colors mb-6">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back to Coupons
      </a>

      <div class="max-w-4xl mx-auto bg-white dark:bg-[#1f2125] rounded-xl overflow-hidden shadow-sm border border-[#e7e2da] dark:border-gray-700">

        <!-- Header -->
        <div class="px-8 pt-8 pb-0">
          <div class="flex items-center gap-3 mb-1">
            <div class="size-10 rounded-lg bg-primary/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-primary">edit</span>
            </div>
            <div>
              <h2 class="text-3xl font-bold tracking-tight text-[#181610] dark:text-white">Edit Coupon</h2>
              <p class="text-[#8d7c5e] mt-0.5">Update the details for coupon <span class="font-bold text-primary"><%= coupon.code %></span></p>
            </div>
          </div>
        </div>

        <!-- Form -->
        <form class="p-8" action="/admin/editcoupon/<%= coupon._id %>" method="POST">

          <!-- Basic Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">

            <!-- Coupon Code -->
            <div class="col-span-1">
              <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Coupon Code</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-[#8d7c5e]">tag</span>
                <input
                  name="code"
                  required
                  value="<%= coupon.code %>"
                  class="w-full pl-12 pr-4 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium uppercase"
                  placeholder="e.g. SPICE2024"
                  type="text"
                />
              </div>
            </div>

            <!-- Status Toggle -->
            <div class="col-span-1">
              <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Coupon Status</label>
              <div class="flex items-center h-14 px-4 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg">
                <span class="text-sm font-medium text-[#8d7c5e] mr-auto">Active Status</span>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    name="isActive"
                    class="sr-only peer"
                    type="checkbox"
                    value="true"
                    <%= coupon.isActive ? "checked" : "" %>
                  />
                  <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
                </label>
              </div>
            </div>

          </div>

          <!-- Discount Details -->
          <div class="mb-10 pt-8 border-t border-[#e7e2da] dark:border-gray-700">
            <h3 class="text-lg font-bold mb-6 text-[#181610] dark:text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">sell</span>
              Discount Details
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

              <!-- Discount Type -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Discount Type</label>
                <div class="relative">
                  <select
                    name="discountType"
                    required
                    class="w-full appearance-none h-14 pl-4 pr-10 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                  >
                    <option value="percentage" <%= coupon.discountType === "percentage" ? "selected" : "" %>>Percentage (%)</option>
                    <option value="fixed"      <%= coupon.discountType === "fixed"      ? "selected" : "" %>>Fixed Amount (&#8377;)</option>
                    <option value="shipping"   <%= coupon.discountType === "shipping"   ? "selected" : "" %>>Free Shipping</option>
                  </select>
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined pointer-events-none text-[#8d7c5e]">expand_more</span>
                </div>
              </div>

              <!-- Discount Value -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Discount Value</label>
                <div class="relative">
                  <input
                    name="discountValue"
                    required
                    value="<%= coupon.discountValue %>"
                    class="w-full pl-4 pr-12 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                    placeholder="20"
                    type="number"
                    min="0"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 text-[#8d7c5e] font-bold" id="valueSymbol">
                    <%= coupon.discountType === "percentage" ? "%" : coupon.discountType === "fixed" ? "₹" : "" %>
                  </span>
                </div>
              </div>

              <!-- Max Discount -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Max Discount Amount (&#8377;)</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#8d7c5e] font-bold">&#8377;</span>
                  <input
                    name="maxDiscount"
                    value="<%= coupon.maxDiscount != null ? coupon.maxDiscount : '' %>"
                    class="w-full pl-10 pr-4 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                    placeholder="No cap"
                    type="number"
                    min="0"
                  />
                </div>
              </div>

            </div>
          </div>

          <!-- Usage & Restrictions -->
          <div class="mb-10 pt-8 border-t border-[#e7e2da] dark:border-gray-700">
            <h3 class="text-lg font-bold mb-6 text-[#181610] dark:text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">rule</span>
              Usage &amp; Restrictions
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

              <!-- Min Purchase -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Min. Purchase (&#8377;)</label>
                <input
                  name="minPurchase"
                  value="<%= coupon.minPurchase %>"
                  class="w-full px-4 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                  placeholder="0.00"
                  type="number"
                  min="0"
                />
              </div>

              <!-- Usage Limit -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Usage Limit / User</label>
                <input
                  name="usageLimit"
                  value="<%= coupon.usageLimit %>"
                  class="w-full px-4 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                  placeholder="1"
                  type="number"
                  min="1"
                />
              </div>

              <!-- Expiry Date -->
              <div>
                <label class="block mb-2 text-sm font-semibold text-[#181610] dark:text-gray-200">Expiry Date</label>
                <div class="relative">
                  <input
                    name="expiryDate"
                    required
                    value="<%= new Date(coupon.expiryDate).toISOString().split('T')[0] %>"
                    class="w-full pl-4 pr-10 h-14 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary outline-none text-[#181610] dark:text-white font-medium"
                    type="date"
                  />
                  <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-[#8d7c5e] pointer-events-none">calendar_month</span>
                </div>
              </div>

            </div>
          </div>

          <!-- Usage Stats (read-only info) -->
          <div class="mb-10 pt-8 border-t border-[#e7e2da] dark:border-gray-700">
            <h3 class="text-lg font-bold mb-4 text-[#181610] dark:text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">bar_chart</span>
              Usage Stats
            </h3>
            <div class="flex items-center gap-6 p-4 bg-[#fbfaf9] dark:bg-background-dark border border-[#e7e2da] dark:border-gray-700 rounded-lg">
              <div class="text-center">
                <p class="text-2xl font-black text-[#181610] dark:text-white"><%= coupon.usedCount %></p>
                <p class="text-xs font-semibold text-[#8d7c5e] uppercase tracking-wide mt-1">Times Used</p>
              </div>
              <div class="h-10 w-px bg-[#e7e2da] dark:bg-gray-700"></div>
              <div class="text-center">
                <p class="text-2xl font-black text-[#181610] dark:text-white"><%= coupon.usageLimit %></p>
                <p class="text-xs font-semibold text-[#8d7c5e] uppercase tracking-wide mt-1">Usage Limit</p>
              </div>
              <div class="flex-1">
                <div class="flex justify-between text-xs font-bold text-[#8d7c5e] mb-1">
                  <span>Progress</span>
                  <span><%= coupon.usageLimit > 0 ? Math.round((coupon.usedCount / coupon.usageLimit) * 100) : 0 %>%</span>
                </div>
                <div class="w-full bg-gray-200 dark:bg-gray-700 h-2 rounded-full overflow-hidden">
                  <div
                    class="<%= coupon.usedCount >= coupon.usageLimit ? 'bg-red-500' : 'bg-primary' %> h-full rounded-full"
                    style="width: <%= coupon.usageLimit > 0 ? Math.min(100, Math.round((coupon.usedCount / coupon.usageLimit) * 100)) : 0 %>%"
                  ></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center justify-end gap-6 pt-8 border-t border-[#e7e2da] dark:border-gray-700">
            <a
              class="text-sm font-bold text-[#8d7c5e] hover:text-[#181610] dark:hover:text-white transition-colors"
              href="/admin/coupons"
            >Cancel &amp; Discard</a>
            <button
              class="px-8 py-4 bg-primary hover:bg-primary/90 text-white font-bold rounded-lg shadow-lg shadow-primary/20 transition-all flex items-center gap-2 active:scale-95"
              type="submit"
            >
              Save Changes
              <span class="material-symbols-outlined text-sm">save</span>
            </button>
          </div>

        </form>
      </div>
    </div>
  </main>

  <script>
    // Update the % / ₹ symbol next to discount value when type changes
    const typeSelect = document.querySelector('select[name="discountType"]');
    const valueSymbol = document.getElementById('valueSymbol');

    typeSelect.addEventListener('change', function () {
      if (this.value === 'percentage') valueSymbol.textContent = '%';
      else if (this.value === 'fixed') valueSymbol.textContent = '₹';
      else valueSymbol.textContent = '';
    });
  </script>

</body>
</html>
