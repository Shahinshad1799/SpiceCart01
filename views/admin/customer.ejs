<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SpiceCart Admin - Customer Moderation (Orange Theme)</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#F97316", // Vibrant Orange
                        "primary-dark": "#EA580C",
                        "saffron": "#FF9933",
                        "background-light": "#FDFCFB",
                        "background-dark": "#131f1b",
                        "sidebar-orange": "#F97316",
                        "active-green": "#16a34a",
                        "inactive-red": "#dc2626",
                        "block-red": "#dc2626",
                        "unblock-green": "#16a34a"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style type="text/tailwindcss">
        body { font-family: 'Manrope', sans-serif; }
        .sidebar-item-active { background-color: rgba(255, 255, 255, 0.2) !important; color: white !important; font-weight: 700; }
        .custom-shadow { box-shadow: rgba(0, 0, 0, 0.06) 0px 4px 12px; }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#121715] dark:text-white transition-colors duration-200">
<div class="flex h-screen overflow-hidden">
<aside class="w-64 bg-sidebar-orange text-white flex flex-col shrink-0">
<div class="p-6">
<div class="flex items-center gap-3">
<div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-lg">
<span class="material-symbols-outlined text-primary text-3xl">restaurant_menu</span>
</div>
<div class="flex flex-col">
<h1 class="text-xl font-extrabold tracking-tight">SpiceCart</h1>
<p class="text-xs text-white/80 uppercase font-semibold tracking-wider">Admin Panel</p>
</div>
</div>
</div>
<nav class="flex-1 px-4 space-y-1.5 mt-4">
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/90 hover:bg-white/10 transition-all" href="#">
<span class="material-symbols-outlined">dashboard</span>
<span class="text-sm font-medium">Dashboard</span>
</a>
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/90 hover:bg-white/10 transition-all" href="#">
<span class="material-symbols-outlined">inventory_2</span>
<span class="text-sm font-medium">Inventory</span>
</a>
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/90 hover:bg-white/10 transition-all" href="#">
<span class="material-symbols-outlined">shopping_cart</span>
<span class="text-sm font-medium">Orders</span>
</a>
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg sidebar-item-active shadow-sm" href="#">
<span class="material-symbols-outlined">group</span>
<span class="text-sm">Customers</span>
</a>
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/90 hover:bg-white/10 transition-all" href="#">
<span class="material-symbols-outlined">bar_chart</span>
<span class="text-sm font-medium">Analytics</span>
</a>
<a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-white/90 hover:bg-white/10 transition-all" href="#">
<span class="material-symbols-outlined">settings</span>
<span class="text-sm font-medium">Settings</span>
</a>
</nav>
<div class="p-4 border-t border-white/20">
<div class="flex items-center gap-3 px-2 mb-4">
<div class="w-9 h-9 rounded-full border-2 border-white/30 overflow-hidden shrink-0">
<img alt="Admin Avatar" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD54EYiPtF_rpEFa7TnPyoC48ZSocVKGMoDSsz7qKEk0wenVkr3IbIyBEzFIu9t1N5SuhJwceO1MZSH_9qJdSRZI4mbtt0uc3pj3pEPcc_xFHv2Nmi-OIo8cp39Shmuqx0zhsj2ENiSWCVuVqmnuu3Pb4CqL1j2p0pWi2LAfyQQxEV875YrbmNzfEhfqlz0e0ka4VmWbVcIJco1T84Mx0JxjgS2VcOxACCQvy_4H1Lk9S1_XE9C_Vl-wp_15Xik6TQjo_jCoicnyUs"/>
</div>
<div class="flex flex-col overflow-hidden">
<span class="text-sm font-bold truncate">Alex Thorne</span>
<span class="text-[10px] text-white/70 uppercase tracking-widest font-semibold">Super Admin</span>
</div>
</div>
<form action="/admin/logout" method="post">
    <button class="w-full bg-white/10 hover:bg-white/20 text-white py-2.5 px-4 rounded-lg flex items-center justify-center gap-2 transition-all border border-white/10">
<span class="material-symbols-outlined text-sm">logout</span>
<span class="text-sm font-semibold">Sign Out</span>
</button>
</form>



</div>
</aside>
<main class="flex-1 overflow-y-auto p-8">
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
<div class="flex flex-col gap-1">
<h2 class="text-3xl font-black text-[#121715] dark:text-white tracking-tight">Customer Managment</h2>
<p class="text-gray-500 dark:text-gray-400 text-sm">Manage user access and block/unblock accounts to maintain store safety.</p>
</div>
</div>
<form id="searchForm" class="flex items-center gap-2" method="GET" action="/admin/customer">
  <div class="relative flex-1">
    <input
      type="text"
      name="q"
      id="searchInput"
      value="<%= search %>"
      placeholder="Search customers by name, email, or ID..."
      class="w-full bg-transparent border rounded px-4 py-2 text-sm focus:ring-1 focus:ring-primary"
    />
    <!-- Clear Button -->
    <button type="button" id="clearBtn" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 <%= search ? '' : 'hidden' %>">
      <span class="material-symbols-outlined">close</span>
    </button>
  </div>
  <button type="submit" class="bg-primary text-white px-4 py-2 rounded text-sm">Search</button>
</form>




<div class="bg-white dark:bg-[#1c2a26] rounded-xl custom-shadow overflow-hidden border border-gray-200 dark:border-white/5">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
  <thead class="bg-gray-50 dark:bg-white/5 border-b border-gray-100 dark:border-white/5">
    <tr>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Avatar</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Customer Details</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Contact</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-center">Orders</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Spent</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
      <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-100 dark:divide-white/5">

    <% customers.forEach(customer => { %>
      <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02] transition-colors">
        <!-- Avatar -->
      <td class="px-6 py-4">
  <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center border-2 border-white shadow-sm overflow-hidden">
    <% if (customer && customer.profileImage) { %>
      <img alt="Avatar" class="w-full h-full object-cover" src="<%= customer.profileImage 
      ? '/uploads/profile/' + customer.profileImage 
      : '/images/default.png' %>" />
    <% } else { %>
      <span class="text-gray-400 font-bold">
        <%= customer && customer.fullname ? customer.fullname.charAt(0) : "?" %>
      </span>
    <% } %>
  </div>
</td>


        <!-- Customer Details -->
     <td class="px-6 py-4">
  <div class="flex flex-col">
    <span class="text-sm font-bold text-[#121715] dark:text-white"><%= customer.fullname || customer.name %></span>
    <span class="text-xs text-gray-400">ID: <%= customer._id %></span>
  </div>
</td>


        <!-- Contact -->
        <td class="px-6 py-4">
          <div class="flex flex-col">
            <span class="text-sm text-[#121715] dark:text-gray-200"><%= customer.email %></span>
            <span class="text-xs text-gray-400"><%= customer.phonenumber %></span>
          </div>
        </td>

        <!-- Orders -->
        <td class="px-6 py-4 text-center">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-gray-200">
            <%= customer.orders || 0 %>
          </span>
        </td>

        <!-- Spent -->
        <td class="px-6 py-4">
          <span class="text-sm font-bold text-primary">$<%= customer.spent ? customer.spent.toFixed(2) : '0.00' %></span>
        </td>

        <!-- Status -->
        <td class="px-6 py-4">
          <% if (customer.status === "Active") { %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 text-active-green dark:bg-green-900/20">
              <span class="w-1.5 h-1.5 rounded-full bg-active-green mr-2"></span> Active
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-inactive-red dark:bg-inactive-red/20">
              <span class="w-1.5 h-1.5 rounded-full bg-inactive-red mr-2"></span> Blocked
            </span>
          <% } %>
        </td>

        <!-- Actions -->
 <td class="px-6 py-4 text-right">
  <button 
    type="button" 
    onclick="confirmAction('<%= customer._id %>', '<%= customer.status %>', '<%= customer.name %>')"
    class="px-4 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 
           <%= customer.status === 'Active' ? 'bg-red-50 hover:bg-red-100 text-block-red border border-red-200' 
                                          : 'bg-green-50 hover:bg-green-100 text-unblock-green border border-green-200' %>">
    <span class="material-symbols-outlined text-[18px]">
      <%= customer.status === 'Active' ? 'block' : 'verified_user' %>
    </span>
    <%= customer.status === 'Active' ? 'Block' : 'Unblock' %>
  </button>
</td>



      </tr>
    <% }) %>

  </tbody>
</table>
</div>
<div class="flex justify-center mt-6 gap-2">
  <% if (currentPage > 1) { %>
    <a href="?q=<%= search %>&page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Prev</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?q=<%= search %>&page=<%= i %>" class="px-3 py-1 rounded 
      <%= i === currentPage ? 'bg-primary text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?q=<%= search %>&page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Next</a>
  <% } %>
</div>

</div>
</main>
</div>
<script>
function confirmAction(id, status, name) {
  Swal.fire({
    title: status === 'Active' ? 'Block Customer?' : 'Unblock Customer?',
    html: `Are you sure you want to <strong>${status === 'Active' ? 'block' : 'unblock'}</strong> <strong>${name}</strong>?`,
    icon: status === 'Active' ? 'warning' : 'success',
    showCancelButton: true,
    confirmButtonText: status === 'Active' ? 'Yes, Block!' : 'Yes, Unblock!',
    cancelButtonText: 'Cancel',
    confirmButtonColor: status === 'Active' ? '#ef4444' : '#10b981', // Tailwind red/green
    cancelButtonColor: '#6b7280',
    background: '#f9fafb',
    iconColor: status === 'Active' ? '#b91c1c' : '#047857',
    showClass: {
      popup: 'animate__animated animate__fadeInDown'
    },
    hideClass: {
      popup: 'animate__animated animate__fadeOutUp'
    }
  }).then((result) => {
    if (result.isConfirmed) {
      // submit form programmatically
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/customer/${id}/${status === 'Active' ? 'block' : 'unblock'}`;
      document.body.appendChild(form);
      form.submit();
    }
  });
}
</script>

<script>
  const searchForm = document.getElementById("searchForm");
  const searchInput = document.getElementById("searchInput");
  const clearBtn = document.getElementById("clearBtn");

  // Show/hide clear button
  searchInput.addEventListener("input", () => {
    clearBtn.classList.toggle("hidden", searchInput.value.trim() === "");
  });

  // Clear button functionality
  clearBtn.addEventListener("click", () => {
    searchInput.value = "";
    clearBtn.classList.add("hidden");
    searchForm.submit(); // reload page with all customers
  });
</script>


</body></html>