<!DOCTYPE html>
<html class="light" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>SpiceCart Admin – Dashboard</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#F97316", // Vibrant Orange
                        "primary-dark": "#EA580C",
                        "saffron": "#FF9933",
                        "background-light": "#FDFCFB",
                        "background-dark": "#131f1b",
                        "sidebar-orange": "#F97316",
                        "active-green": "#16a34a",
                        "inactive-red": "#dc2626",
                        "block-red": "#dc2626",
                        "unblock-green": "#16a34a"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
  <style>
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    body { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-800 dark:text-white min-h-screen flex antialiased">

<%- include("../partials/sidebar") %>

<main class="flex-1 ml-64 p-8">

  <!-- Header -->
  <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 dark:text-white">Dashboard Overview</h1>
      <p class="text-slate-500 dark:text-white/50 text-sm">Welcome back! Here's what's happening with SpiceCart.</p>
    </div>
    <a href="/admin/report"
       class="flex items-center gap-2 bg-primary text-white px-5 py-2 rounded-lg shadow-sm font-semibold text-sm hover:bg-primary-dark transition-all">
      <span class="material-symbols-outlined text-[18px]">bar_chart</span>
      Full Sales Report
    </a>
  </header>

  <!-- KPI Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <% const kpiCards = [
      { label: 'Total Revenue',    value: '₹' + kpi.totalRevenue,   icon: 'payments',     bg: 'bg-blue-50',   iconColor: 'text-blue-600'   },
      { label: 'Total Orders',     value: kpi.totalOrders,           icon: 'shopping_bag', bg: 'bg-orange-50', iconColor: 'text-orange-600' },
      { label: 'Total Customers',  value: kpi.totalCustomers,        icon: 'person_add',   bg: 'bg-purple-50', iconColor: 'text-purple-600' },
      { label: 'Products Count',   value: kpi.totalProducts,         icon: 'style',        bg: 'bg-pink-50',   iconColor: 'text-pink-600'   },
    ]; %>
    <% kpiCards.forEach(card => { %>
    <div class="bg-white dark:bg-white/5 border border-slate-100 dark:border-white/10 p-6 rounded-2xl shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div class="p-2 <%= card.bg %> <%= card.iconColor %> rounded-lg">
          <span class="material-symbols-outlined"><%= card.icon %></span>
        </div>
      </div>
      <p class="text-slate-500 dark:text-white/50 text-sm font-medium"><%= card.label %></p>
      <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1"><%= card.value %></h3>
    </div>
    <% }) %>
  </div>

  <!-- Chart + Low Stock -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">

    <!-- Sales Chart -->
    <div class="lg:col-span-2 bg-white dark:bg-white/5 border border-slate-100 dark:border-white/10 p-6 rounded-2xl shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-bold text-lg dark:text-white">Sales Overview</h2>
        <span class="text-xs text-slate-400 dark:text-white/40 font-medium">Last 6 months</span>
      </div>
      <div class="h-64 relative">
        <canvas id="salesChart"></canvas>
      </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="bg-white dark:bg-white/5 border border-slate-100 dark:border-white/10 p-6 rounded-2xl shadow-sm">
      <h2 class="font-bold text-lg mb-6 dark:text-white">Low Stock Alerts</h2>

      <% if (lowStock.length === 0) { %>
        <div class="text-center py-8 text-slate-400 dark:text-white/30">
          <span class="material-symbols-outlined text-4xl block mb-2">inventory_2</span>
          <p class="text-sm">All products are well stocked.</p>
        </div>
      <% } %>

      <div class="space-y-4">
       <% lowStock.forEach(product => { %>
  <div class="flex items-center gap-4 p-3 hover:bg-slate-50 dark:hover:bg-white/5 rounded-xl transition-colors">
    <!-- <div class="w-12 h-12 bg-slate-100 dark:bg-white/10 rounded-lg overflow-hidden flex-shrink-0 flex items-center justify-center">
      <% if (product.images) { %>
        <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover"/>
      <% } else { %>
        <span class="material-symbols-outlined text-slate-400">image</span>
      <% } %>
    </div> -->
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold truncate dark:text-white"><%= product.name %></p>
            <p class="text-xs text-slate-500 dark:text-white/40">Only <%= product.stock %> left</p>
          </div>
          <div class="text-right">
            <% if (product.urgent) { %>
              <span class="inline-block px-2 py-1 bg-red-100 text-red-600 text-[10px] font-bold rounded uppercase">Urgent</span>
            <% } else { %>
              <span class="inline-block px-2 py-1 bg-yellow-100 text-yellow-600 text-[10px] font-bold rounded uppercase">Reorder</span>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>

      <a href="/admin/products?filter=lowstock"
         class="block w-full mt-6 py-2 text-primary text-sm font-bold text-center hover:bg-orange-50 dark:hover:bg-primary/10 rounded-lg transition-colors border border-primary/20">
        View All Alerts
      </a>
    </div>
  </div>

  <!-- Recent Orders -->
  <div class="bg-white dark:bg-white/5 border border-slate-100 dark:border-white/10 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 dark:border-white/10 flex items-center justify-between">
      <h2 class="font-bold text-lg dark:text-white">Recent Orders</h2>
      <a href="/admin/orders" class="text-sm font-semibold text-slate-500 dark:text-white/40 hover:text-primary transition-colors">View All Orders</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-slate-50 dark:bg-white/5 border-b border-slate-100 dark:border-white/10">
          <tr>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-white/40 uppercase tracking-wider">Order ID</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-white/40 uppercase tracking-wider">Customer</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-white/40 uppercase tracking-wider">Product</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-white/40 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 dark:text-white/40 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-white/10">
          <% if (recentOrders.length === 0) { %>
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-slate-400 dark:text-white/30">
                <span class="material-symbols-outlined text-4xl block mb-2 opacity-40">inbox</span>
                No orders yet.
              </td>
            </tr>
          <% } %>
          <% const statusColors = {
            delivered:  'bg-green-100 text-green-700',
            shipped:    'bg-orange-100 text-orange-700',
            confirmed:  'bg-blue-100 text-blue-700',
            processing: 'bg-blue-100 text-blue-700',
            pending:    'bg-yellow-100 text-yellow-700',
            cancelled:  'bg-red-100 text-red-700',
            returned:   'bg-purple-100 text-purple-700',
          }; %>
          <% recentOrders.forEach(order => { %>
          <tr class="hover:bg-slate-50 dark:hover:bg-white/5 transition-colors">
            <td class="px-6 py-4 text-sm font-bold text-primary"><%= order.shortId %></td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-[10px] font-bold text-primary">
                  <%= order.initials %>
                </div>
                <span class="text-sm text-slate-700 dark:text-white/80"><%= order.customerName %></span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-600 dark:text-white/60"><%= order.productName %></td>
            <td class="px-6 py-4 text-sm font-bold dark:text-white">₹<%= order.amount %></td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-[10px] font-bold rounded-full uppercase <%= statusColors[order.status] || statusColors.pending %>">
                <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<script>
  const chartData = <%- chartData %>;

  if (chartData.length > 0) {
    const ctx = document.getElementById('salesChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: chartData.map(d => d.label),
        datasets: [
          {
            label: 'Revenue (₹)',
            data: chartData.map(d => d.revenue),
            backgroundColor: 'rgba(249,115,22,0.15)',
            borderColor: '#F97316',
            borderWidth: 2,
            borderRadius: 6,
            yAxisID: 'y',
          },
          {
            label: 'Orders',
            data: chartData.map(d => d.orders),
            type: 'line',
            borderColor: '#6366f1',
            backgroundColor: 'transparent',
            borderWidth: 2,
            pointBackgroundColor: '#6366f1',
            tension: 0.4,
            yAxisID: 'y1',
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { font: { family: 'Manrope' } } } },
        scales: {
          y:  { position: 'left',  beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
          y1: { position: 'right', beginAtZero: true, grid: { drawOnChartArea: false } },
          x:  { grid: { display: false } }
        }
      }
    });
  } else {
    document.getElementById('salesChart').parentElement.innerHTML =
      '<div class="h-64 flex flex-col items-center justify-center text-slate-300"><span class="material-symbols-outlined text-5xl">monitoring</span><p class="text-sm mt-2">No data yet</p></div>';
  }
</script>
</body>
</html>