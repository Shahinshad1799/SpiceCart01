<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SpiceCart Admin Categories Management</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#F97316", // Vibrant Orange
                        "primary-dark": "#EA580C",
                        "saffron": "#FF9933",
                        "background-light": "#FDFCFB",
                        "background-dark": "#131f1b",
                        "sidebar-orange": "#F97316",
                        "active-green": "#16a34a",
                        "inactive-red": "#dc2626",
                        "block-red": "#dc2626",
                        "unblock-green": "#16a34a"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .material-symbols-outlined.font-fill-1 {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Manrope', sans-serif;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark min-h-screen text-[#181611] dark:text-white">
<div class="flex h-screen overflow-hidden">
<%- include("../partials/sidebar") %>
  <main class="flex-1 overflow-y-auto p-8 ml-64">
<div class="max-w-7xl mx-auto p-8 lg:p-12">
<div class="flex flex-wrap justify-between items-center gap-6 mb-10">
<div>
<h2 class="text-4xl font-black text-[#181611] dark:text-white tracking-tight">Categories</h2>
<p class="text-[#8a7e60] dark:text-gray-400 mt-1 font-medium">Organize and classify your spice collections.</p>
</div>
<a href="/admin/addcatagory">
    <button class="flex items-center gap-2 bg-primary text-emerald-dark h-12 px-6 rounded-xl font-bold shadow-lg hover:shadow-xl transition-all active:scale-95">
<span class="material-symbols-outlined">add</span>
<span>Add New Category</span>
</button>
</a>

</div>
<form id="searchForm" class="flex items-center gap-2" method="GET" action="/admin/catagory">
  <div class="relative flex-1">
    <input
      type="text"
      name="q"
      id="searchInput"
      value="<%= search %>"
      placeholder="Search customers by name, email, or ID..."
      class="w-full bg-transparent border rounded px-4 py-2 text-sm focus:ring-1 focus:ring-primary"
    />
    <!-- Clear Button -->
    <button type="button" id="clearBtn" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 <%= search ? '' : 'hidden' %>">
      <span class="material-symbols-outlined">close</span>
    </button>
  </div>
  <button type="submit" class="bg-primary text-white px-4 py-2 rounded text-sm">Search</button>
</form>
<div class="bg-white dark:bg-[#222] rounded-xl border border-[#e6e3db] dark:border-gray-800 shadow-sm overflow-hidden">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-gray-50 dark:bg-[#2a2a2a] border-bottom border-[#e6e3db] dark:border-gray-800">
<th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-[#8a7e60] dark:text-gray-400">Image</th>
<th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-[#8a7e60] dark:text-gray-400">Category Name</th>
<th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-[#8a7e60] dark:text-gray-400">Number of Products</th>
<th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-[#8a7e60] dark:text-gray-400 text-right">Actions</th>
</tr>
</thead>
<tbody class="divide-y divide-[#e6e3db] dark:divide-gray-800">
<% catagory.forEach(catagorys => { %>

<tr class="hover:bg-gray-50/80 dark:hover:bg-white/5 transition-colors group">

<td class="px-6 py-4">
<div class="size-14 rounded-lg bg-cover bg-center border border-[#e6e3db] dark:border-gray-700 overflow-hidden bg-gray-100"
style="background-image: url('/uploads/catagory/<%= catagorys.image %>');">
</div>
</td>

<td class="px-6 py-4">
<div>
<p class="font-bold text-[#181611] dark:text-white"><%= catagorys.name %></p>
<p class="text-xs text-[#8a7e60] font-medium"><%= catagorys.description %></p>
</div>
</td>

<td class="px-6 py-4">
<span class="px-3 py-1 bg-emerald-dark/5 dark:bg-primary/5 text-emerald-dark dark:text-primary rounded-lg text-sm font-bold">
0 Products
</span>
</td>

<td class="px-6 py-4 text-right">
  <div class="flex justify-end gap-2">
   <a href="/admin/catagory/<%= catagorys._id %>/edit">
  <button class="p-2 rounded-lg hover:bg-primary/20 text-[#181611] dark:text-white transition-all">
    <span class="material-symbols-outlined text-lg">edit</span>
  </button>
</a>
  

    <% const isActive = catagorys.status === 'Active'; %>
    <button 
      type="button" 
      onclick='confirmAction("<%= catagorys._id %>", "<%= catagorys.status %>", "<%= catagorys.name %>")'
      class="px-4 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 
             <%= isActive ? 'bg-red-50 hover:bg-red-100 text-red-600 border border-red-200' 
                          : 'bg-green-50 hover:bg-green-100 text-green-600 border border-green-200' %>">
      <span class="material-symbols-outlined text-[18px]">
        <%= isActive ? 'block' : 'verified_user' %>
      </span>
      <%= isActive ? 'Block' : 'Unblock' %>
    </button>

  </div>
</td>


</tr>

<% }) %>
</tbody>
</table>
</div>
</div>
<div class="flex justify-center mt-6 gap-2">
  <% if (currentPage > 1) { %>
    <a href="?q=<%= search %>&page=<%= currentPage - 1 %>" class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Prev</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?q=<%= search %>&page=<%= i %>" class="px-3 py-1 rounded 
      <%= i === currentPage ? 'bg-primary text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
      <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?q=<%= search %>&page=<%= currentPage + 1 %>" class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300">Next</a>
  <% } %>
</div>
</div>
</main>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
function confirmAction(id, status, name) {
  const isActive = status === 'Active';

  Swal.fire({
    title: isActive ? 'Block Category?' : 'Unblock Category?',
    text: `Are you sure you want to ${isActive ? 'block' : 'unblock'} ${name}?`,
    icon: isActive ? 'warning' : 'success',
    showCancelButton: true,
    confirmButtonText: isActive ? 'Yes, Block!' : 'Yes, Unblock!',
    cancelButtonText: 'Cancel',
    confirmButtonColor: isActive ? '#ef4444' : '#10b981',
    cancelButtonColor: '#6b7280',
    background: '#f9fafb',
    iconColor: isActive ? '#b91c1c' : '#047857',
    showClass: {
      popup: 'animate__animated animate__fadeInDown'
    },
    hideClass: {
      popup: 'animate__animated animate__fadeOutUp'
    }
  }).then((result) => {
    if (result.isConfirmed) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/catagory/${id}/${isActive ? 'block' : 'unblock'}`;

      document.body.appendChild(form);
      form.submit();
    }
  });
}</script>
<script>
  const searchForm = document.getElementById("searchForm");
  const searchInput = document.getElementById("searchInput");
  const clearBtn = document.getElementById("clearBtn");

  // Show/hide clear button
  searchInput.addEventListener("input", () => {
    clearBtn.classList.toggle("hidden", searchInput.value.trim() === "");
  });

  // Clear button functionality
  clearBtn.addEventListener("click", () => {
    searchInput.value = "";
    clearBtn.classList.add("hidden");
    searchForm.submit(); // reload page with all customers
  });
</script>

</body></html>