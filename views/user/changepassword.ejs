<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Change Password</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73", // Muted Gold for stars
                        "forest": "#4C5E4E", // Forest Green for accents
                        "muted-green": "#F0F3F1", // Soft muted background
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>.no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<%- include("../partials/header", { title: "changepassword" }) %>
<main class="flex-1 bg-muted-green dark:bg-[#1A120E]">
<section class="px-6 py-10 lg:px-20 xl:px-40 min-h-[calc(100vh-80px)]">
<div class="mx-auto max-w-[1280px]">
<div class="flex justify-center w-full">
<div class="w-full max-w-3xl">
<div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="p-6 lg:p-8">
<form class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8" action="/changepassword" method="post">
<div class="col-span-1 md:col-span-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Current Password</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">lock</span>
<input class="w-full h-12 pl-12 pr-12 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium tracking-widest" placeholder="••••••••••••" name="currentPassword" type="password"/>
<button type="button" onclick="togglePassword('currentPasswordInput', 'currentPasswordIcon')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#886e63] dark:text-[#9CA3AF] hover:text-primary transition-colors" tabindex="-1" aria-label="Show password">
<span class="material-symbols-outlined text-[20px]" id="currentPasswordIcon">visibility</span>
</button>
</div>
</div>
<div class="col-span-1 md:col-span-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">New Password</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">key</span>
<input class="w-full h-12 pl-12 pr-12 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium tracking-widest" placeholder="••••••••••••" name="newPassword" type="password"/>
<button type="button" onclick="togglePassword('newPasswordInput', 'newPasswordIcon')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#886e63] dark:text-[#9CA3AF] hover:text-primary transition-colors" tabindex="-1" aria-label="Show password">
<span class="material-symbols-outlined text-[20px]" id="newPasswordIcon">visibility</span>
</button>
 <p class="text-red-500 text-xs mt-1 hidden" id="newPasswordError"></p>
</div>
</div>
<div class="col-span-1 md:col-span-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Confirm New Password</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">check_circle</span>
<input class="w-full h-12 pl-12 pr-12 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium tracking-widest" placeholder="••••••••••••" name="confirmPassword" type="password"/>
<button type="button" onclick="togglePassword('confirmPasswordInput', 'confirmPasswordIcon')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#886e63] dark:text-[#9CA3AF] hover:text-primary transition-colors" tabindex="-1" aria-label="Show password">
<span class="material-symbols-outlined text-[20px]" id="confirmPasswordIcon">visibility</span>
</button>
 <p class="text-red-500 text-xs mt-1 hidden" id="confirmPasswordError"></p>
</div>
</div>
<div class="col-span-1 md:col-span-2 pt-6 flex justify-end border-t border-[#f4f1f0] dark:border-[#3E302A] mt-2">
<button class="h-12 px-8 rounded-lg bg-primary hover:bg-primary/90 text-white font-bold transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center gap-2" type="submit">
<span class="material-symbols-outlined">shield_lock</span>
                                        Update Password
                                    </button>
</div>
</form>
</div>
</div>
</div>
</div>
</div>
</section>
</main>
<%- include("../partials/footer") %>
</div>
<script>
  function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === "password") {
      input.type = "text";
      icon.textContent = "visibility_off";
    } else {
      input.type = "password";
      icon.textContent = "visibility";
    }
  }
</script>
<script>
// Grab the form and inputs
const changeForm = document.querySelector("form[action='/changepassword']");
const currentPassword = changeForm.querySelector("input[name='currentPassword']");
const newPassword = changeForm.querySelector("input[name='newPassword']");
const confirmPassword = changeForm.querySelector("input[name='confirmPassword']");

// Give inputs the IDs the toggle buttons target
currentPassword.id = "currentPasswordInput";
newPassword.id = "newPasswordInput";
confirmPassword.id = "confirmPasswordInput";

// Create error elements
[currentPassword, newPassword, confirmPassword].forEach(input => {
    const p = document.createElement("p");
    p.className = "mt-1 text-xs text-red-500 hidden";
    input.parentNode.appendChild(p);
    input.errorElement = p;
});

// Strong password regex: min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 special char
const strongPassword = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;

// Helper functions
function showError(input, message) {
    input.errorElement.textContent = message;
    input.errorElement.classList.remove("hidden");
    input.classList.add("border-red-500");
}

function clearError(input) {
    input.errorElement.textContent = "";
    input.errorElement.classList.add("hidden");
    input.classList.remove("border-red-500");
}

// Real-time validation
newPassword.addEventListener("input", () => {
    if (!strongPassword.test(newPassword.value)) {
        showError(newPassword, "Password must be 8+ chars, include uppercase, lowercase, number & symbol.");
    } else {
        clearError(newPassword);
    }

    // confirmPassword check
    if (confirmPassword.value && confirmPassword.value !== newPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
    } else {
        clearError(confirmPassword);
    }
});

confirmPassword.addEventListener("input", () => {
    if (confirmPassword.value !== newPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
    } else {
        clearError(confirmPassword);
    }
});

// Submit validation
changeForm.addEventListener("submit", (e) => {
    let isValid = true;

    if (!currentPassword.value) {
        showError(currentPassword, "Current password is required.");
        isValid = false;
    } else {
        clearError(currentPassword);
    }

    if (!strongPassword.test(newPassword.value)) {
        showError(newPassword, "Password must be 8+ chars, include uppercase, lowercase, number & symbol.");
        isValid = false;
    } else {
        clearError(newPassword);
    }

    if (confirmPassword.value !== newPassword.value || !confirmPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
        isValid = false;
    } else {
        clearError(confirmPassword);
    }

    if (!isValid) e.preventDefault();
});
</script>
</body></html>
