<script>
// Grab the form and inputs
const changeForm = document.querySelector("form[action='/changepassword']");
const currentPassword = changeForm.querySelector("input[name='currentPassword']");
const newPassword = changeForm.querySelector("input[name='newPassword']");
const confirmPassword = changeForm.querySelector("input[name='confirmPassword']");

// Create error elements
[currentPassword, newPassword, confirmPassword].forEach(input => {
    const p = document.createElement("p");
    p.className = "mt-1 text-xs text-red-500 hidden";
    input.parentNode.appendChild(p);
    input.errorElement = p;
});

// Strong password regex: min 8 chars, 1 uppercase, 1 lowercase, 1 number, 1 special char
const strongPassword = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;

// Helper functions
function showError(input, message) {
    input.errorElement.textContent = message;
    input.errorElement.classList.remove("hidden");
    input.classList.add("border-red-500");
}

function clearError(input) {
    input.errorElement.textContent = "";
    input.errorElement.classList.add("hidden");
    input.classList.remove("border-red-500");
}

// Real-time validation
newPassword.addEventListener("input", () => {
    if (!strongPassword.test(newPassword.value)) {
        showError(newPassword, "Password must be 8+ chars, include uppercase, lowercase, number & symbol.");
    } else {
        clearError(newPassword);
    }

    // confirmPassword check
    if (confirmPassword.value && confirmPassword.value !== newPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
    } else {
        clearError(confirmPassword);
    }
});

confirmPassword.addEventListener("input", () => {
    if (confirmPassword.value !== newPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
    } else {
        clearError(confirmPassword);
    }
});

// Submit validation
changeForm.addEventListener("submit", (e) => {
    let isValid = true;

    if (!currentPassword.value) {
        showError(currentPassword, "Current password is required.");
        isValid = false;
    } else {
        clearError(currentPassword);
    }

    if (!strongPassword.test(newPassword.value)) {
        showError(newPassword, "Password must be 8+ chars, include uppercase, lowercase, number & symbol.");
        isValid = false;
    } else {
        clearError(newPassword);
    }

    if (confirmPassword.value !== newPassword.value || !confirmPassword.value) {
        showError(confirmPassword, "Passwords do not match.");
        isValid = false;
    } else {
        clearError(confirmPassword);
    }

    if (!isValid) e.preventDefault();
});
</script>
