<!DOCTYPE html>
<html><head>
<meta charset="utf-8"/>
<link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
<link as="style" href="https://fonts.googleapis.com/css2?display=swap&amp;family=Epilogue%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" onload="this.rel='stylesheet'" rel="stylesheet"/>
<title>Stitch Design</title>
<link href="data:image/x-icon;base64," rel="icon" type="image/x-icon"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body>
<div class="w-full flex flex-1 py-5">
<div class="w-full px-10">
<%- include("../partials/header")%>
<div class="px-40 flex flex-1 justify-center py-5">
<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
<div class="flex flex-wrap justify-between gap-3 p-4"><p class="text-[#181311] tracking-light text-[32px] font-bold leading-tight min-w-72">Shop All Spices</p></div>
<div class="flex gap-3 p-3 flex-wrap pr-4">
<div class="flex gap-3 p-3 flex-wrap pr-4">

  <!-- CATEGORY DROPDOWN -->
  <div class="relative">
    <button onclick="toggleCategoryDropdown()" 
      class="flex h-10 items-center justify-between gap-2 rounded-lg bg-[#f4f1f0] px-4 w-48">
  <span id="selectedCategory"><%= selectedCategoryName || "All Categories" %></span>
      <span class="material-symbols-outlined">expand_more</span>
    </button>

    <div id="categoryDropdown" 
      class="hidden absolute mt-2 w-48 bg-white border rounded-lg shadow-lg z-10">

<div onclick="selectCategory('All', 'All Categories')" 
     class="p-2 hover:bg-gray-100 cursor-pointer">
  All Categories
</div>

<% catagory.forEach(cat => { %>
  <div onclick="selectCategory('<%= cat._id %>', '<%= cat.name %>')" 
       class="p-2 hover:bg-gray-100 cursor-pointer">
    <%= cat.name %>
  </div>
<% }) %>

    </div>
  </div>

  <!-- PRICE SLIDER -->
  <div class="flex flex-col w-64 bg-[#f4f1f0] p-3 rounded-lg">
    <label class="text-sm font-medium text-gray-700">
      Price: ₹<span id="priceValue"><%= selectedPrice || 1000 %></span>
    </label>

    <input 
      type="range" 
      min="0" 
      max="5000" 
      value="<%= selectedPrice || 1000 %>"
      id="priceSlider"
      class="w-full mt-2 cursor-pointer"
    >
  </div>

  <!-- APPLY BUTTON -->
  <button onclick="applyFilters()" 
    class="bg-orange-500 text-white px-4 py-2 rounded-lg">
    Apply
  </button>

</div>
</div>
<div class="px-6 w-full py-5">

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">

    <% if (products && products.length > 0) { %>

      <% products.forEach(product => { %>

        <a href="/productdetails/<%= product._id %>" 
           class="flex flex-col gap-3 group cursor-pointer hover:shadow-lg p-3 rounded-lg transition bg-white">

          <!-- Image -->
          <% const img = product.images && product.images.length > 0 
            ? product.images[0] 
            : "/images/default.png"; %>

          <img 
            src="/uploads/product/<%= img %>" 
            class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition"
          />

          <!-- Details -->
          <div class="flex flex-col gap-2">

            <div>
              <p class="text-[#181311] text-base font-bold">
                <%= product.name %>
              </p>

              <p class="text-[#886e63] text-sm line-clamp-2">
                <%= product.description %>
              </p>
            </div>

            <!-- Price + Arrow -->
            <div class="flex items-center justify-between mt-2">

              <p class="text-[#181311] text-base font-bold">
                ₹<%= product.variants[0]?.price || "N/A" %>
              </p>

              <span class="material-symbols-outlined text-orange-500 group-hover:translate-x-1 transition">
                arrow_forward
              </span>

            </div>

          </div>

        </a>

      <% }) %>

    <% } else { %>

      <p class="text-center col-span-3 text-gray-500">
        No products available
      </p>

    <% } %>

  </div>

</div>

</div>
</div>
<%- include("../partials/footer") %>

</body><script>
let selectedCategoryId = "<%= selectedCategory || '' %>";
let selectedCategoryName = "All Categories";

function toggleCategoryDropdown() {
  document.getElementById("categoryDropdown").classList.toggle("hidden");
}

function selectCategory(id, name) {
  selectedCategoryId = id;
  selectedCategoryName = name;

  document.getElementById("selectedCategory").innerText = name;
  document.getElementById("categoryDropdown").classList.add("hidden");
}

// PRICE
const slider = document.getElementById("priceSlider");
const priceValue = document.getElementById("priceValue");

slider.addEventListener("input", () => {
  priceValue.innerText = slider.value;
});

// APPLY FILTER
function applyFilters() {
  const price = slider.value;

  let url = "/shop?";

  if (selectedCategoryId && selectedCategoryId !== "All") {
    url += "category=" + selectedCategoryId + "&";
  }

  if (price) {
    url += "maxPrice=" + price;
  }

  window.location.href = url;
}
</script>
</html>