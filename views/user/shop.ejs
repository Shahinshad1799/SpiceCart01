<!DOCTYPE html>

<html><head>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<meta charset="utf-8"/>
<link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
<link as="style" href="https://fonts.googleapis.com/css2?display=swap&amp;family=Epilogue%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" onload="this.rel='stylesheet'" rel="stylesheet"/>
<title>Stitch Design</title>
<link href="data:image/x-icon;base64," rel="icon" type="image/x-icon"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style>
        input[type='range'] {
            accent-color: #181311;
        }
    </style>
</head>
<body>
<div class="relative flex h-auto min-h-screen w-full flex-col bg-white group/design-root overflow-x-hidden" style='font-family: Epilogue, "Noto Sans", sans-serif;'>
<div class="layout-container flex h-full grow flex-col">
<%- include("../partials/header") %>
<main class="flex px-4 gap-4 py-8">
<!-- Sidebar -->
<aside class="w-64 shrink-0 flex flex-col gap-8 
              sticky top-20 
              max-h-[calc(100vh-120px)] 
              overflow-y-auto">  <div class="flex flex-col gap-4">
<h3 class="text-[#181311] text-base font-bold">Filters</h3>
<div class="flex flex-col gap-2">
  <p class="text-[#886e63] text-xs font-medium uppercase tracking-wider">Category</p>

  <div class="flex flex-col gap-1">

    <!-- ALL -->
    <a href="/shop"
       class="flex items-center h-10 px-4 rounded-lg text-sm leading-normal transition-colors
       <%= !selectedCategory ? 'bg-[#f4f1f0] text-[#181311] font-bold' : 'text-[#181311] font-medium hover:bg-[#f4f1f0]' %>">
      All Categories
    </a>

    <!-- DYNAMIC CATEGORIES -->
    <% catagory.forEach(cat => { %>
      <a href="/shop?category=<%= cat._id %>&q=<%= search %>&sort=<%= sort %>%>"
         class="flex items-center h-10 px-4 rounded-lg text-sm leading-normal transition-colors
         <%= selectedCategory == cat._id.toString()
             ? 'bg-[#f4f1f0] text-[#181311] font-bold'
             : 'text-[#181311] font-medium hover:bg-[#f4f1f0]' %>">
        <%= cat.name %>
      </a>
    <% }) %>

  </div>
</div>
</div>
<form method="GET" action="/shop" id="filterForm">
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">

    <!-- Header -->
    <div class="flex justify-between items-center">
      <p class="text-[#886e63] text-xs font-medium uppercase tracking-wider">
        Price Range
      </p>

      <span class="text-[#181311] text-xs font-bold">
        ₹0 - ₹<span id="priceValue"><%= selectedPrice || 1000 %></span>
      </span>
    </div>

    <!-- Slider -->
    <input 
      type="range"
      name="maxPrice"
      min="0"
      max="1000"
      step="10"
      value="<%= selectedPrice || 1000 %>"
      id="priceRange"
      class="w-full h-1.5 bg-[#f4f1f0] rounded-lg appearance-none cursor-pointer"
    />

  </div>
</div>
</form>

