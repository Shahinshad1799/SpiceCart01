<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Shopping Cart - Spice Market</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73", // Muted Gold for stars
                        "forest": "#4C5E4E", // Forest Green for accents
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>.no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<%- include("../partials/header") %>
<main class="flex-1 py-10 lg:py-16 px-6 lg:px-20 xl:px-40 bg-background-light dark:bg-background-dark">
<div class="mx-auto max-w-[1280px]">
<div class="flex items-center gap-2 mb-8 text-sm text-[#886e63] dark:text-[#9CA3AF]">
<a class="hover:text-primary" href="#">Home</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-[#181311] dark:text-white font-medium">Shopping Cart</span>
</div>
<h1 class="text-3xl lg:text-5xl font-bold text-[#181311] dark:text-white mb-10">Your Cart</h1>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
<div class="lg:col-span-8">
<div class="bg-white dark:bg-[#1A120E] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="hidden md:grid grid-cols-12 gap-4 border-b border-[#E6E0DC] dark:border-[#3E302A] p-6 bg-[#fcfbfb] dark:bg-[#211611] text-sm font-bold text-[#5C4D46] dark:text-[#A8A29E] uppercase tracking-wider">
<div class="col-span-6">Product</div>
<div class="col-span-2 text-center">Quantity</div>
<div class="col-span-2 text-right">Price</div>
<div class="col-span-2 text-right">Total</div>
</div>
<% if (cartItems.length > 0) { %>
  <% cartItems.forEach(item => { %>

  <div class="flex flex-col md:grid md:grid-cols-12 gap-6 md:gap-4 items-center border-b border-[#E6E0DC] dark:border-[#3E302A] p-6">

    <!-- PRODUCT -->
    <div class="flex items-center gap-5 w-full md:col-span-6">
      <div class="size-24 rounded-xl overflow-hidden bg-gray-100 border">
       <img 
  src="/uploads/product/<%= item.productId?.images?.[0] || 'default.png' %>" 
  class="w-full h-full object-cover"
/>
      </div>

      <div>
        <h3 class="font-bold text-lg">
          <%= item.productId.name %>
        </h3>

        <%
  const variant = item.productId.variants.find(v => 
    v._id.toString() === item.variantId?.toString()
  );
%>

<p class="text-sm text-gray-500">
  <%= variant ? variant.name : "Variant not selected" %>
</p>

        <!-- REMOVE -->
        <form action="/cart/remove" method="POST">
  <input type="hidden" name="productId" value="<%= item.productId._id %>">
  <input type="hidden" name="variantId" value="<%= item.variantId %>"> <!-- ✅ ADD THIS -->

  <button type="submit" class="text-red-500 text-sm mt-2">
    Remove
  </button>
</form>
      </div>
    </div>

    <!-- QUANTITY -->
    <div class="flex justify-center md:col-span-2">
     <form action="/cart/update" method="POST" class="flex items-center">
  <input type="hidden" name="productId" value="<%= item.productId._id %>">
  <input type="hidden" name="variantId" value="<%= item.variantId %>"> <!-- ✅ ADD THIS -->

  <button type="submit" name="change" value="-1">-</button>

  <input value="<%= item.quantity %>" readonly class="w-10 text-center">

  <button type="submit" name="change" value="1">+</button>
</form>
    </div>

    <!-- PRICE -->
    <div class="text-right md:col-span-2">
      ₹ <%= item.productId?.variants?.[0]?.price || 0 %>
    </div>

    <!-- TOTAL -->
    <div class="text-right md:col-span-2 font-bold">
      ₹ <%= (item.productId?.variants?.[0]?.price || 0) * item.quantity %>
    </div>

  </div>

  <% }) %>
<% } else { %>
  <p class="p-6 text-center">Your cart is empty</p>
<% } %>
</div>
<div class="mt-8">
<a class="inline-flex items-center gap-2 text-primary font-bold hover:text-primary/80 transition-colors" href="/shop">
<span class="material-symbols-outlined">arrow_back</span>
                                Continue Shopping
                            </a>
</div>
</div>
<div class="lg:col-span-4">
<div class="bg-white dark:bg-[#1A120E] border border-[#E6E0DC] dark:border-[#3E302A] rounded-2xl p-6 lg:p-8 shadow-lg lg:sticky lg:top-32">
<h2 class="text-xl font-bold mb-6 text-[#181311] dark:text-white">Order Summary</h2>
<<div class="flex justify-between">
  <span>Subtotal (<%= totalItems %> items)</span>
  <span>₹ <%= subtotal.toFixed(2) %></span>
</div>

<div class="flex justify-between">
  <span>Shipping</span>
  <span>₹ <%= shipping %></span>
</div>

<div class="flex justify-between">
  <span>Tax</span>
  <span>₹ <%= tax.toFixed(2) %></span>
</div>

<div class="flex justify-between font-bold text-lg">
  <span>Total</span>
  <span>₹ <%= total.toFixed(2) %></span>
</div>
<div class="mb-6">
<div class="flex gap-2">
<input class="flex-1 rounded-lg border-[#E6E0DC] dark:border-[#3E302A] bg-transparent text-sm placeholder-[#886e63] focus:border-primary focus:ring-primary dark:text-white" placeholder="Promo code" type="text"/>
<button class="px-4 py-2 bg-[#f4f1f0] dark:bg-[#2C201A] text-[#181311] dark:text-white font-medium rounded-lg hover:bg-[#e6e0dc] dark:hover:bg-[#3E302A] transition-colors text-sm">Apply</button>
</div>
</div>
<div class="border-t-2 border-dashed border-[#E6E0DC] dark:border-[#3E302A] py-6 mb-2">
<div class="flex justify-between items-end">
<span class="font-bold text-lg text-[#181311] dark:text-white">Order Total</span>
<span class="font-black text-2xl text-primary">$64.40</span>
</div>
<p class="text-xs text-[#886e63] dark:text-[#9CA3AF] mt-2 text-right">Taxes calculated at checkout</p>
</div>
<button class="w-full h-14 bg-primary text-white rounded-lg font-bold text-lg hover:bg-primary/90 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 group">
                            Proceed to Checkout
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
<div class="mt-6 flex items-center justify-center gap-2 text-xs text-[#886e63] dark:text-[#9CA3AF]">
<span class="material-symbols-outlined text-sm">lock</span>
                            Secure Checkout
                        </div>
</div>
</div>
</div>
</div>
</main>
<%- include("../partials/footer") %>
</div>

</body></html>