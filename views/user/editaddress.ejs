<input class="w-full rounded-xl border border-[#d1d5db] bg-white px-4 py-3 text-[#181311] placeholder:text-[#886e63] focus:border-[#ea580c] focus:ring-1 focus:ring-[#ea580c] outline-none transition-all" id="phone" name="phonenumber" value=<%= address.phonenumber %> type="tel"/>
<p class="text-red-500 text-sm mt-1 hidden" id="phoneError"></p>

</div>
</div>
<div class="flex flex-col gap-2">
<label class="text-sm font-bold text-[#181311]" for="address">Street Address</label>
<input class="w-full rounded-xl border border-[#d1d5db] bg-white px-4 py-3 text-[#181311] placeholder:text-[#886e63] focus:border-[#ea580c] focus:ring-1 focus:ring-[#ea580c] outline-none transition-all" id="address" name="address" value=<%= address.address %> type="text"/>
<p class="text-red-500 text-sm mt-1 hidden" id="addressError"></p>
</div>
<div class="flex flex-col gap-2">
<label class="text-sm font-bold text-[#181311]" for="apt">Apartment, Suite, etc. (Optional)</label>
<input class="w-full rounded-xl border border-[#d1d5db] bg-white px-4 py-3 text-[#181311] placeholder:text-[#886e63] focus:border-[#ea580c] focus:ring-1 focus:ring-[#ea580c] outline-none transition-all" id="apt" name="appartment"  type="text" value="<%= address.appartment %>" />
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="flex flex-col gap-2">
<label class="text-sm font-bold text-[#181311]" for="city">City</label>
<input class="w-full rounded-xl border border-[#d1d5db] bg-white px-4 py-3 text-[#181311] placeholder:text-[#886e63] focus:border-[#ea580c] focus:ring-1 focus:ring-[#ea580c] outline-none transition-all" id="city" name="city" value=<%= address.city  %> type="text"/>
