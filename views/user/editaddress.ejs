<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="flex flex-col gap-2">
<label class="text-sm font-bold text-[#181311]" for="full-name">Full Name</label>
<input class="w-full rounded-xl border border-[#d1d5db] bg-white px-4 py-3 text-[#181311] placeholder:text-[#886e63] focus:border-[#ea580c] focus:ring-1 focus:ring-[#ea580c] outline-none transition-all" id="full-name" name="fullname" value=<%= address.fullname %> type="text"/>
