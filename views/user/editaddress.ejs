<script>
const form = document.querySelector("form");

const fullname = document.querySelector("input[name='fullname']");
const phone = document.querySelector("input[name='phonenumber']");
const address = document.querySelector("input[name='address']");
const city = document.querySelector("input[name='city']");
const state = document.querySelector("select[name='state']");
const zipcode = document.querySelector("input[name='zipcode']");

// ===== Helper Functions =====
function showError(input, id, message) {
  const error = document.getElementById(id);
  error.textContent = message;
  error.classList.remove("hidden");
  input.classList.add("border-red-500");
}

function clearError(input, id) {
  const error = document.getElementById(id);
  error.textContent = "";
  error.classList.add("hidden");
  input.classList.remove("border-red-500");
}

// ===== Individual Field Validation =====

function validateFullname() {
  if (!/^[A-Za-z ]{3,}$/.test(fullname.value.trim())) {
    showError(fullname, "fullnameError", "Enter valid full name (min 3 letters)");
    return false;
  }
  clearError(fullname, "fullnameError");
  return true;
}

function validatePhone() {
  if (!/^[0-9]{10}$/.test(phone.value.trim())) {
    showError(phone, "phoneError", "Phone must be 10 digits");
    return false;
  }
  clearError(phone, "phoneError");
  return true;
}

function validateAddress() {
  if (address.value.trim().length < 5) {
    showError(address, "addressError", "Enter valid street address");
    return false;
  }
  clearError(address, "addressError");
  return true;
}

function validateCity() {
  if (!/^[A-Za-z ]{2,}$/.test(city.value.trim())) {
    showError(city, "cityError", "Enter valid city");
    return false;
  }
  clearError(city, "cityError");
  return true;
}

function validateState() {
  if (!state.value) {
    showError(state, "stateError", "Select a state");
    return false;
  }
  clearError(state, "stateError");
  return true;
}

function validateZip() {
  if (!/^[0-9]{5,6}$/.test(zipcode.value.trim())) {
    showError(zipcode, "zipError", "Enter valid zip code");
    return false;
  }
  clearError(zipcode, "zipError");
  return true;
}

// ===== Real-Time Validation =====
fullname.addEventListener("input", validateFullname);
phone.addEventListener("input", validatePhone);
address.addEventListener("input", validateAddress);
city.addEventListener("input", validateCity);
state.addEventListener("change", validateState);
zipcode.addEventListener("input", validateZip);

// ===== Final Submit Check =====
form.addEventListener("submit", (e) => {
  const isValid =
    validateFullname() &&
    validatePhone() &&
    validateAddress() &&
    validateCity() &&
    validateState() &&
    validateZip();

  if (!isValid) {
    e.preventDefault();
  }
});
</script>
</body></html>