<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Login</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73", // Muted Gold for stars
                        "forest": "#4C5E4E", // Forest Green for accents
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<div class="w-full flex justify-center py-8 lg:py-10">
<div class="flex items-center gap-2 cursor-pointer">
<span class="material-symbols-outlined text-primary" style="font-size: 32px;">local_fire_department</span>
<h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-[#181311] dark:text-white">Spice Cart</h2>
</div>
</div>
<main class="flex-1 flex items-start justify-center pb-12 px-6 lg:px-20 xl:px-40">
<div class="flex w-full max-w-[1080px] bg-white dark:bg-[#2C201A] rounded-2xl overflow-hidden shadow-2xl border border-[#f4f1f0] dark:border-[#3E302A]">
<div class="w-full lg:w-1/2 p-8 sm:p-12 xl:p-16 flex flex-col justify-center">
<div class="mb-8">
<h1 class="text-3xl font-bold text-[#181311] dark:text-white mb-2">Welcome Back</h1>
<p class="text-[#886e63] dark:text-[#9CA3AF] font-body">Log in to access your spice collection and recipes.</p>
</div>
<form class="space-y-5" method="post" action="/login">
<div class="space-y-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white" for="email">Email Address</label>
<input class="w-full h-12 rounded-lg bg-[#f4f1f0] dark:bg-[#1A120E] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#211611] focus:ring-0 transition-colors text-[#181311] dark:text-white px-4 placeholder-[#886e63]/50" id="email" placeholder="you@example.com" name="email" type="email"/>
</div>
<div class="space-y-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white" for="password">Password</label>
<input class="w-full h-12 rounded-lg bg-[#f4f1f0] dark:bg-[#1A120E] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#211611] focus:ring-0 transition-colors text-[#181311] dark:text-white px-4 placeholder-[#886e63]/50" id="password" placeholder="Enter your password" name="password" type="password"/>
</div>
<div class="flex justify-end pt-1">
<a class="text-sm font-bold text-primary hover:underline" href="/forgotpassword">Forgot Password?</a>
</div>
<button class="w-full h-12 bg-primary hover:bg-primary/90 text-white font-bold rounded-lg transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center justify-center gap-2 mt-2">
                            Log In
                            <span class="material-symbols-outlined text-[20px]">login</span>
</button>
<div class="mt-4">
  <a href="/auth/google"
    class="w-full h-12 flex items-center justify-center gap-3 border border-gray-300 rounded-lg bg-white hover:bg-gray-50 transition">
    
    <img src="https://www.svgrepo.com/show/475656/google-color.svg" 
         class="w-5 h-5" alt="Google">
         
    <span class="font-medium text-gray-700">
      Continue with Google
    </span>
  </a>
</div>

</form>
<div class="mt-8 text-center">
<p class="text-sm text-[#5C4D46] dark:text-[#A8A29E] font-body">
                            Don't have an account? 
                            <a class="text-primary font-bold hover:underline ml-1" href="/signup">Sign up</a>
</p>
</div>
</div>
<div class="hidden lg:block w-1/2 relative bg-[#f4f1f0] dark:bg-[#1A120E]">
<img alt="Spices" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB57wCUrHqr1bJmfsAcPDN36yftPiNGg_lN0dXp5CwzuwTN2q9nXcYjuDAD8U8jw-mb-HqA7c_5aaTAk-jWY4fuJ8xk1vlZEIt2TS52byXQ-bstINyZRG86-YLqnPCBjrce9UpzfHWeouglKIqmIYqlRLWK-TF6tFN9h6ONx2u656HR6hQ431otQgZ5zNb2uqszjnmIeuVc9-HhhnmyjiVN0jRlR9M999Pxj30WMGYPKn-ii-cIClGUGza5nhp2nchgI8nHOS0OIpU"/>
<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80"></div>
<div class="absolute bottom-0 left-0 w-full p-12 text-white">
<div class="bg-white/20 backdrop-blur-md rounded-xl p-6 border border-white/10 animate-bounce-slow">
<span class="material-symbols-outlined text-4xl text-primary mb-4">eco</span>
<h3 class="text-2xl font-bold mb-2">Taste the Authentic</h3>
<p class="text-white/80 font-body">"The freshness of these spices completely transformed my cooking. I'll never go back to supermarket brands."</p>
<div class="flex items-center gap-2 mt-4">
<div class="flex text-secondary text-sm">
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
</div>
<span class="text-xs font-bold text-white uppercase tracking-wider">• Trusted by 10k+ Chefs</span>
</div>
</div>
</div>
</div>
</div>
</main>
<footer class="py-8 text-center text-sm text-[#886e63] dark:text-[#9CA3AF]">
<div class="flex flex-col items-center gap-4">
<p>© 2024 Spice Market. All rights reserved.</p>
<div class="flex gap-6 text-xs">
<a class="hover:text-primary transition-colors" href="#">Privacy Policy</a>
<a class="hover:text-primary transition-colors" href="#">Terms of Service</a>
<a class="hover:text-primary transition-colors" href="#">Help Center</a>
</div>
</div>
</footer>
</div>
<% if (typeof success !== "undefined") { %>
<div id="toast"
     class="fixed bottom-6 right-6 bg-green-600 text-white px-8 py-4 rounded-xl shadow-2xl text-base font-medium
            transform translate-y-20 opacity-0 transition-all duration-500">
  <%= success %>
</div>

<script>
  const toast = document.getElementById("toast");

  // Show animation
  setTimeout(() => {
    toast.classList.remove("translate-y-20", "opacity-0");
  }, 100);

  // Hide after 3 seconds
  setTimeout(() => {
    toast.classList.add("translate-y-20", "opacity-0");
  }, 3000);
</script>
<% } %>


<% if (typeof error !== "undefined") { %>
<div id="toast"
     class="fixed bottom-6 right-6 bg-red-600 text-white px-8 py-4 rounded-xl shadow-2xl text-base font-medium
            transform translate-y-20 opacity-0 transition-all duration-500">
  <%= error %>
</div>

<script>
  const toas = document.getElementById("toast");

  setTimeout(() => {
    toas.classList.remove("translate-y-20", "opacity-0");
  }, 100);

  setTimeout(() => {
    toas.classList.add("translate-y-20", "opacity-0");
  }, 3000);
</script>
<% } %>


</body></html>