<span class="material-symbols-outlined text-[#181311] text-sm" style="font-variation-settings: 'FILL' 0;">star</span>
</div>
<p class="text-[#181311] text-base font-medium leading-normal">"A bit pricey, but you get what you pay for. Will buy again."</p>
<div class="flex items-center gap-2 text-sm text-[#886e63]">
<span class="font-bold text-[#181311]">Sarah J.</span>
<span>•</span>
<span>Nov 15, 2023</span>
</div>
</div>
</div>
<button class="w-full md:w-auto h-10 px-6 rounded-lg border border-[#e6e2e0] bg-white text-[#181311] text-sm font-bold hover:bg-[#f4f1f0] transition-colors self-start">See all reviews</button>
</div>

<% if (relatedProducts.length > 0) { %>

<div class="mt-10">
  <h2 class="text-2xl font-bold mb-4">Related Products</h2>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <% relatedProducts.forEach(p => { %>

     
         <a href="/productdetails/<%= p._id %>">

        <img 
          src="/uploads/product/<%= p.images[0] %>" 
          class="w-full h-40 object-cover rounded"
        />

        <p class="font-semibold mt-2"><%= p.name %></p>
        <p class="text-sm text-gray-500">
          ₹<%= p.variants[0]?.price || "N/A" %>
        </p>

      </a>

    <% }) %>
  </div>
</div>

<% } %>

</div>
</div>

<%- include("../partials/footer") %>
</body>
<script>
const mainImage = document.getElementById("mainImage");

mainImage.addEventListener("mousemove", (e) => {
  const rect = mainImage.getBoundingClientRect();

  const x = ((e.clientX - rect.left) / rect.width) * 100;
  const y = ((e.clientY - rect.top) / rect.height) * 100;

  mainImage.style.backgroundPosition = `${x}% ${y}%`;
});

mainImage.addEventListener("mouseleave", () => {
  mainImage.style.backgroundPosition = "center";
});
</script>
<!-- SCRIPT -->
<script>
  function changeImage(img) {
    document.getElementById("mainImage").style.backgroundImage =
      `url('/uploads/product/${img}')`;
  }

  //  FIX VARIANT
  function selectVariant(variantId, price, el) {
    // update price
    document.getElementById("price").innerText = price;

    // update hidden input
    document.getElementById("variantId").value = variantId;

    // UI active state
    document.querySelectorAll(".variant-btn").forEach(btn => {
      btn.classList.remove("bg-black","text-white");
      btn.classList.add("bg-white");
    });

    el.classList.add("bg-black","text-white");
  }

  //  FIX QUANTITY
  function changeQty(val) {
    let qty = document.getElementById("qty");
    let current = parseInt(qty.value) || 1;

    if (current + val > 0) {
      let newQty = current + val;
      qty.value = newQty;

      // update hidden input
      document.getElementById("finalQty").value = newQty;
    }
  }

  // ALSO HANDLE MANUAL INPUT
  document.getElementById("qty").addEventListener("input", function() {
    let val = parseInt(this.value) || 1;
    if (val < 1) val = 1;

    this.value = val;
    document.getElementById("finalQty").value = val;
  });
</script>
<script>
function changeImage(img) {
  const main = document.getElementById("mainImage");

  main.style.backgroundImage = `url('/uploads/product/${img}')`;
  main.style.backgroundPosition = "center";
}
</script>


</html>