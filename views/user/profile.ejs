<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Account Settings</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73", // Muted Gold for stars
                        "forest": "#4C5E4E", // Forest Green for accents
                        "muted-green": "#F0F3F1", // Soft muted background
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>.no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<%- include("../partials/header", { title: "Profile" }) %>
<main class="flex-1 bg-muted-green dark:bg-[#1A120E]">
<section class="px-6 py-10 lg:px-20 xl:px-40 min-h-[calc(100vh-80px)]">
<div class="mx-auto max-w-[1280px]">
<div class="mb-8 flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
<a class="hover:text-primary" href="/home">Home</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-[#181311] dark:text-white font-medium">Account Settings</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<%- include("../partials/profilecard") %>
<div class="lg:col-span-8 xl:col-span-9">
<div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="px-6 py-6 lg:px-8 border-b border-[#f4f1f0] dark:border-[#3E302A]">
<h1 class="text-2xl font-bold text-[#181311] dark:text-white mb-6">Account Details</h1>
<div class="flex flex-wrap gap-2 overflow-x-auto no-scrollbar pb-1">
     <button class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold shadow-md shadow-primary/20 transition-all">Details</button>
  <a href="/address">
    <button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Address</button>

  </a>  
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Order</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Wallet</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Referral</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">FAQ</button>
</div>
</div>
<div class="p-6 lg:p-8">
<form class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8">
<div class="col-span-1 md:col-span-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Fullname</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">person</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium" type="text" name="fullname" value=<%=user.fullname %> />
</div>
</div>
<div class="col-span-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Email Address</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">mail</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium" type="email" name="email" value=<%=user.email %> />
</div>
</div>
<div class="col-span-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Phone Number</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">call</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium" type="tel" name="phonenumber" value=<%= user.phonenumber || "Notaddedd" %>/>
</div>
</div>
<div class="col-span-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Date of Birth</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">calendar_month</span>
<input
  class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611]
         border-transparent focus:border-primary focus:bg-white
         dark:focus:bg-[#2C201A] focus:ring-0 transition-all
         text-[#181311] dark:text-white font-medium"
  type="date"
  name="dateofbirth"
  value="<%= user.dateofbirth ? user.dateofbirth.toISOString().split('T')[0] : '' %>"
/>
</div>
</div>
<div class="col-span-1">
<div class="flex justify-between items-center mb-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white">Password</label>
</div>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">lock</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium tracking-widest" type="password" value="Password123"/>
</div>
</div>

</form>
</div>
</div>
</div>
</div>
</div>
</section>
</main>
<%- include("../partials/footer") %>
</div>
</body></html>