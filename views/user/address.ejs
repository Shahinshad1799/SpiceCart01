<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Saved Addresses</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73",
                        "forest": "#4C5E4E",
                        "muted-green": "#F0F3F1",
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<%- include("../partials/header", { title: "Address" }) %>
<main class="flex-1 bg-muted-green dark:bg-[#1A120E]">
<section class="px-6 py-10 lg:px-20 xl:px-40 min-h-[calc(100vh-80px)]">
<div class="mx-auto max-w-[1280px]">
<div class="mb-8 flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
<a class="hover:text-primary" href="/home">Home</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-[#181311] dark:text-white font-medium">Addresses</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<%- include("../partials/profilecard") %>
  <div class="lg:col-span-8 xl:col-span-9">
<div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="px-6 py-6 lg:px-8 border-b border-[#f4f1f0] dark:border-[#3E302A]">
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
<h1 class="text-2xl font-bold text-[#181311] dark:text-white">Saved Addresses</h1>
<a href="/addaddress">
    <button class="h-10 px-6 rounded-lg bg-primary hover:bg-primary/90 text-white text-sm font-bold transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center justify-center gap-2">
<span class="material-symbols-outlined text-lg">add</span>
                                        Add New Address
                                    </button>
</a>

</div>
<div class="flex flex-wrap gap-2 overflow-x-auto no-scrollbar pb-1">
  <a href="/profile">
        <button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Details</button>
  </a>
<button class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold shadow-md shadow-primary/20 transition-all">Addresses</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Orders</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Wallet</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Referral</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">FAQ</button>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

  <% if (addresses && addresses.length > 0) { %>

    <% addresses.forEach(address => { %>

      <div class="group relative p-6 rounded-xl 
        <%= address.isdefault ? 
            'border-2 border-primary bg-white dark:bg-[#3E302A]' : 
            'border border-[#E6E0DC] dark:border-[#3E302A] bg-white dark:bg-[#2C201A]' 
        %> 
        shadow-sm transition-all hover:shadow-md">

        <!-- HEADER SECTION -->
        <div class="flex justify-between items-start mb-4">

          <div>
            <h4 class="font-bold text-[#181311] dark:text-white flex items-center gap-2">
              <%= address.fullname %>

              <% if(address.isdefault){ %>
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider 
                  bg-primary/10 text-primary rounded-full border border-primary/20">
                  Default
                </span>
              <% } %>
            </h4>
          </div>

          <!-- BUTTONS -->
          <div class="flex gap-1">
            <a href="/editaddress/<%= address._id %>"
               class="p-1.5 rounded-lg text-[#886e63] hover:text-primary hover:bg-[#f4f1f0] dark:hover:bg-[#211611] transition-colors">
              <span class="material-symbols-outlined text-lg">edit</span>
            </a>

    <form action="/deleteaddress/<%= address._id %>" method="POST">
  <button type="submit"
    class="p-1.5 rounded-lg text-[#886e63] hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
    <span class="material-symbols-outlined text-lg">delete</span>
  </button>
</form>

          </div>

        </div> <!-- ✅ CLOSED PROPERLY -->

        <!-- ADDRESS BODY -->
        <div class="space-y-1">
          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.address %>
          </p>

          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.apartment %>
          </p>

          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.city %>, <%= address.state %>, <%= address.zipcode %>
          </p>
        </div>

        <!-- PHONE -->
        <div class="mt-4 pt-4 border-t border-[#f4f1f0] dark:border-[#2C201A] flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
          <span class="material-symbols-outlined text-sm">call</span>
          <%= address.phonenumber %>
        </div>

      </div>

    <% }) %>

  <% } else { %>

    <div class="col-span-2 text-center text-gray-500">
      No addresses found.
    </div>

  <% } %>

</div>

</div>
</div>
</div>
</div>
</section>
</main>
<%- include("../partials/footer") %>
</div>

</body></html>