<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Saved Addresses</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73",
                        "forest": "#4C5E4E",
                        "muted-green": "#F0F3F1",
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<header class="sticky top-0 z-50 w-full border-b border-[#E6E0DC] dark:border-[#3E302A] bg-white/90 dark:bg-[#211611]/90 backdrop-blur-md transition-all duration-300">
<div class="layout-container flex h-full flex-col">
<div class="flex items-center justify-between px-6 py-4 lg:px-20 xl:px-40">
<div class="flex items-center gap-4 lg:gap-12 flex-1">
<div class="flex items-center gap-2 cursor-pointer">
<span class="material-symbols-outlined text-primary" style="font-size: 32px;">local_fire_department</span>
<h2 class="text-xl lg:text-2xl font-bold tracking-tight text-[#181311] dark:text-white">Spice Cart</h2>
</div>
<div class="hidden md:flex flex-1 max-w-md">
<label class="flex w-full items-center h-12 rounded-full bg-[#f4f1f0] dark:bg-[#2C201A] border border-transparent focus-within:border-primary/50 transition-colors overflow-hidden px-4">
<span class="material-symbols-outlined text-[#886e63] dark:text-[#9CA3AF]">search</span>
<input class="flex-1 bg-transparent border-none focus:ring-0 text-base ml-2 placeholder-[#886e63] dark:placeholder-[#9CA3AF] text-[#181311] dark:text-white h-full" placeholder="Search for saffron, curry..."/>
</label>
</div>
</div>
<div class="flex items-center justify-end gap-6 lg:gap-8">
<nav class="hidden lg:flex items-center gap-8 font-body font-medium text-sm">
<a class="hover:text-primary transition-colors" href="#">Shop</a>
<a class="hover:text-primary transition-colors" href="#">About</a>
<a class="hover:text-primary transition-colors" href="#">Recipes</a>
<a class="hover:text-primary transition-colors" href="#">Blog</a>
</nav>
<div class="flex items-center gap-3">
<div class="hidden sm:flex items-center gap-4">
<button class="text-[#5C4D46] dark:text-[#A8A29E] hover:text-primary transition-colors">
<span class="material-symbols-outlined">notifications</span>
</button>
<div class="h-6 w-px bg-[#E6E0DC] dark:bg-[#3E302A]"></div>
<div class="flex items-center gap-3 cursor-pointer group">
<div class="size-9 rounded-full overflow-hidden border border-[#E6E0DC] dark:border-[#3E302A]">
    <span class="material-symbols-outlined">account_circle</span></div>
</div>
</div>
<button class="lg:hidden flex items-center justify-center size-10 rounded-full hover:bg-[#f4f1f0] dark:hover:bg-[#2C201A]">
<span class="material-symbols-outlined">menu</span>
</button>
</div>
</div>
</div>
</div>
</header>
<main class="flex-1 bg-muted-green dark:bg-[#1A120E]">
<section class="px-6 py-10 lg:px-20 xl:px-40 min-h-[calc(100vh-80px)]">
<div class="mx-auto max-w-[1280px]">
<div class="mb-8 flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
<a class="hover:text-primary" href="#">Home</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-[#181311] dark:text-white font-medium">Addresses</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<%- include("../partials/profilecard") %>
  <div class="lg:col-span-8 xl:col-span-9">
<div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="px-6 py-6 lg:px-8 border-b border-[#f4f1f0] dark:border-[#3E302A]">
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
<h1 class="text-2xl font-bold text-[#181311] dark:text-white">Saved Addresses</h1>
<a href="/addaddress">
    <button class="h-10 px-6 rounded-lg bg-primary hover:bg-primary/90 text-white text-sm font-bold transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center justify-center gap-2">
<span class="material-symbols-outlined text-lg">add</span>
                                        Add New Address
                                    </button>
</a>

</div>
<div class="flex flex-wrap gap-2 overflow-x-auto no-scrollbar pb-1">
  <a href="/profile">
        <button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Details</button>
  </a>
<button class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold shadow-md shadow-primary/20 transition-all">Addresses</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Orders</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Wallet</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Referral</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">FAQ</button>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

  <% if (addresses && addresses.length > 0) { %>

    <% addresses.forEach(address => { %>

      <div class="group relative p-6 rounded-xl 
        <%= address.isdefault ? 
            'border-2 border-primary bg-white dark:bg-[#3E302A]' : 
            'border border-[#E6E0DC] dark:border-[#3E302A] bg-white dark:bg-[#2C201A]' 
        %> 
        shadow-sm transition-all hover:shadow-md">

        <!-- HEADER SECTION -->
        <div class="flex justify-between items-start mb-4">

          <div>
            <h4 class="font-bold text-[#181311] dark:text-white flex items-center gap-2">
              <%= address.fullname %>

              <% if(address.isdefault){ %>
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider 
                  bg-primary/10 text-primary rounded-full border border-primary/20">
                  Default
                </span>
              <% } %>
            </h4>
          </div>

          <!-- BUTTONS -->
          <div class="flex gap-1">
            <a href="/editaddress/<%= address._id %>"
               class="p-1.5 rounded-lg text-[#886e63] hover:text-primary hover:bg-[#f4f1f0] dark:hover:bg-[#211611] transition-colors">
              <span class="material-symbols-outlined text-lg">edit</span>
            </a>

    <form action="/deleteaddress/<%= address._id %>" method="POST">
  <button type="submit"
    class="p-1.5 rounded-lg text-[#886e63] hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
    <span class="material-symbols-outlined text-lg">delete</span>
  </button>
</form>

          </div>

        </div> <!-- ✅ CLOSED PROPERLY -->

        <!-- ADDRESS BODY -->
        <div class="space-y-1">
          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.address %>
          </p>

          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.apartment %>
          </p>

          <p class="text-sm text-[#5C4D46] dark:text-[#E6E0DC]">
            <%= address.city %>, <%= address.state %>, <%= address.zipcode %>
          </p>
        </div>

        <!-- PHONE -->
        <div class="mt-4 pt-4 border-t border-[#f4f1f0] dark:border-[#2C201A] flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
          <span class="material-symbols-outlined text-sm">call</span>
          <%= address.phonenumber %>
        </div>

      </div>

    <% }) %>

  <% } else { %>

    <div class="col-span-2 text-center text-gray-500">
      No addresses found.
    </div>

  <% } %>

</div>

</div>
</div>
</div>
</div>
</section>
</main>
<footer class="bg-[#211611] text-[#E6E0DC] border-t border-[#3E302A]">
<div class="px-6 py-16 lg:px-20 xl:px-40 layout-container">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
<div class="flex flex-col gap-4">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary" style="font-size: 28px;">local_fire_department</span>
<h2 class="text-xl font-bold text-white">Spice Market</h2>
</div>
<p class="text-[#9CA3AF] text-sm leading-relaxed">
                        Bringing the world's finest single-origin spices to your kitchen. Ethically sourced, expertly curated.
                    </p>
<div class="flex gap-4 mt-2">
<a class="text-[#9CA3AF] hover:text-white transition-colors" href="#">
<span class="sr-only">Instagram</span>
<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
</a>
<a class="text-[#9CA3AF] hover:text-white transition-colors" href="#">
<span class="sr-only">Twitter</span>
<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path></svg>
</a>
</div>
</div>
<div>
<h4 class="font-bold text-white mb-6">Shop</h4>
<ul class="flex flex-col gap-3 text-sm text-[#9CA3AF]">
<li><a class="hover:text-primary transition-colors" href="#">All Spices</a></li>
<li><a class="hover:text-primary transition-colors" href="#">Signature Blends</a></li>
<li><a class="hover:text-primary transition-colors" href="#">Gift Sets</a></li>
<li><a class="hover:text-primary transition-colors" href="#">New Arrivals</a></li>
</ul>
</div>
<div>
<h4 class="font-bold text-white mb-6">Company</h4>
<ul class="flex flex-col gap-3 text-sm text-[#9CA3AF]">
<li><a class="hover:text-primary transition-colors" href="#">Our Story</a></li>
<li><a class="hover:text-primary transition-colors" href="#">Sourcing</a></li>
<li><a class="hover:text-primary transition-colors" href="#">Wholesale</a></li>
<li><a class="hover:text-primary transition-colors" href="#">Contact</a></li>
</ul>
</div>
<div>
<h4 class="font-bold text-white mb-6">Contact Us</h4>
<ul class="flex flex-col gap-3 text-sm text-[#9CA3AF]">
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-sm">mail</span>
                            hello@spicemarket.com
                        </li>
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-sm">phone</span>
                            +1 (555) 123-4567
                        </li>
<li class="flex items-center gap-2">
<span class="material-symbols-outlined text-sm">location_on</span>
                            123 Spice Route, Portland, OR
                        </li>
</ul>
</div>
</div>
<div class="border-t border-[#3E302A] mt-16 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
<p class="text-xs text-[#6B7280]">© 2024 Spice Market. All rights reserved.</p>
<div class="flex gap-6 text-xs text-[#6B7280]">
<a class="hover:text-white" href="#">Privacy Policy</a>
<a class="hover:text-white" href="#">Terms of Service</a>
</div>
</div>
</div>
</footer>
</div>

</body></html>