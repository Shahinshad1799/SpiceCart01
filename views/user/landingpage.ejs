<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Authentic Flavors</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73",
                        "forest": "#4C5E4E",
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>.no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">


<header class="sticky top-0 z-50 w-full border-b border-[#E6E0DC] dark:border-[#3E302A] bg-white/90 dark:bg-[#211611]/90 backdrop-blur-md transition-all duration-300">
<div class="flex items-center justify-between gap-4 px-6 py-4 lg:px-12 xl:px-20">

  <!-- LOGO -->
  <div class="flex items-center flex-shrink-0 gap-2 cursor-pointer">
    <span
      class="material-symbols-outlined text-primary"
      style="font-size: 32px;"
    >
      local_fire_department
    </span>

    <h2 class="text-xl lg:text-2xl font-bold tracking-tight text-[#181311] dark:text-white">
      Spice Cart
    </h2>
  </div>

  <!-- SEARCH -->
  <div class="hidden md:flex flex-1 max-w-md mx-4 lg:mx-8">
<form method="GET" action="/shop" class="flex items-center gap-3">

  <!-- SEARCH -->
  <div class="relative flex-1 min-w-[420px] max-w-[600px]">

    <input
      type="text"
      name="q"
      id="searchInput"
      value="<%= typeof search !== 'undefined' ? search : '' %>"
      placeholder="Search product"
      class="w-full border rounded px-4 py-2 text-sm"
    />

    <button
      type="button"
      id="clearBtn"
      class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 <%= search ? '' : 'hidden' %>"
    >
      ✕
    </button>

  </div>

  <!-- PRESERVE CATEGORY -->
  <input
    type="hidden"
    name="category"
    value="<%= typeof selectedCategory !== 'undefined' ? selectedCategory : 'All' %>"
  >

  <!-- PRESERVE SORT -->
  <input
    type="hidden"
    name="sort"
    value="<%= typeof sort !== 'undefined' ? sort : '' %>"
  >

  <button
    type="submit"
    class="h-10 px-5 rounded bg-primary text-white text-sm font-semibold"
  >
    Search
  </button>

</form>
  </div>

  <!-- NAVIGATION + SIGNUP -->
  <div class="flex items-center justify-end gap-4 lg:gap-6 flex-shrink-0">

    <nav class="hidden lg:flex items-center gap-6 font-body font-medium text-sm">
      <a class="hover:text-primary transition-colors" href="/home">
        Home
      </a>

      <a class="hover:text-primary transition-colors" href="/shop">
        Shop
      </a>

      <a class="hover:text-primary transition-colors" href="/about">
        About us
      </a>

      <a class="hover:text-primary transition-colors" href="/contact">
        Contact us
      </a>
    </nav>

    <form action="/signup" method="get">
      <input
        type="submit"
        value="Sign up"
        class="h-10 px-5 lg:px-6 rounded-full bg-primary hover:bg-primary/90 text-white font-bold transition-transform active:scale-95 text-sm cursor-pointer"
      />
    </form>

    <!-- MOBILE MENU -->
    <button
      type="button"
      class="lg:hidden flex items-center justify-center size-10 rounded-full hover:bg-[#f4f1f0] dark:hover:bg-[#2C201A]"
    >
      <span class="material-symbols-outlined">menu</span>
    </button>

  </div>

</div>

</header>
<main class="flex-1">

  <!-- HERO: unchanged, still static marketing copy -->
  <section class="relative px-6 py-12 lg:px-20 xl:px-40 lg:py-20">
    <div class="mx-auto max-w-[1280px]">
      <div class="flex flex-col-reverse lg:flex-row gap-12 items-center">
        <div class="flex-1 flex flex-col gap-6 items-start text-left lg:pr-10 z-10">
          <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary uppercase tracking-wide">
            <span class="size-2 rounded-full bg-primary animate-pulse"></span>
                                New Harvest
                            </div>
          <h1 class="text-4xl lg:text-6xl font-black leading-[1.1] tracking-tight text-[#181311] dark:text-white">
                                Awaken Your Senses with <span class="text-primary">Authentic Flavors</span>
</h1>
          <p class="text-lg text-[#5C4D46] dark:text-[#A8A29E] font-body leading-relaxed max-w-xl">
                                Hand-sourced, single-origin spices delivered fresh from the farm to your pantry. Experience the true taste of nature with our curated collections.
                            </p>
          <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto mt-2">
            <a href="/shop" class="h-12 px-8 rounded-lg bg-primary hover:bg-primary/90 text-white font-bold transition-transform active:scale-95 flex items-center justify-center gap-2 shadow-lg shadow-primary/30">
                                    Explore Collection
                                    <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
</a>
            <a href="/about" class="h-12 px-8 rounded-lg bg-white dark:bg-[#2C201A] border border-[#E6E0DC] dark:border-[#3E302A] hover:border-primary text-[#181311] dark:text-white font-bold transition-all flex items-center justify-center gap-2">
<span class="material-symbols-outlined text-[20px]">play_circle</span>
                                    Our Story
                                </a>
</div>
        </div>
        <div class="flex-1 w-full relative group">
<div class="absolute -inset-4 bg-gradient-to-tr from-primary/20 to-transparent rounded-[2rem] blur-2xl opacity-50 dark:opacity-20"></div>
          <div class="relative w-full aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl bg-[#f4f1f0] dark:bg-[#2C201A]">
            <img alt="Close up of various colorful spices in wooden spoons on a textured surface" class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB57wCUrHqr1bJmfsAcPDN36yftPiNGg_lN0dXp5CwzuwTN2q9nXcYjuDAD8U8jw-mb-HqA7c_5aaTAk-jWY4fuJ8xk1vlZEIt2TS52byXQ-bstINyZRG86-YLqnPCBjrce9UpzfHWeouglKIqmIYqlRLWK-TF6tFN9h6ONx2u656HR6hQ431otQgZ5zNb2uqszjnmIeuVc9-HhhnmyjiVN0jRlR9M999Pxj30WMGYPKn-ii-cIClGUGza5nhp2nchgI8nHOS0OIpU"/>
</div>
          <div class="absolute -bottom-6 -left-6 lg:bottom-8 lg:-left-8 bg-white dark:bg-[#2C201A] p-4 rounded-xl shadow-xl border border-[#f4f1f0] dark:border-[#3E302A] flex items-center gap-4 animate-bounce-slow">
<div class="bg-[#FDF2EC] dark:bg-primary/20 p-3 rounded-full text-primary">
<span class="material-symbols-outlined">eco</span>
</div>
            <div>
<p class="font-bold text-sm">100% Organic</p>
<p class="text-xs text-[#886e63]">Certified Sources</p>
</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORIES: now loops over `categories`, rendered as a draggable slider -->
  <section class="px-6 py-12 lg:px-20 xl:px-40 bg-white dark:bg-[#1A120E]">
    <div class="mx-auto max-w-[1280px]">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl lg:text-3xl font-bold text-[#181311] dark:text-white">Explore Categories</h2>
        <a class="text-primary font-bold hover:underline flex items-center gap-1" href="/shop">
          View All <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>

      <% if (categories && categories.length > 0) { %>
        <div class="relative">
          <div id="categorySlider" class="no-scrollbar cursor-grab flex gap-4 lg:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 -mx-1 px-1">
            <% categories.forEach(function(cat) { %>
              <a class="group relative aspect-[4/5] w-[45%] sm:w-[30%] md:w-[23%] flex-shrink-0 snap-start overflow-hidden rounded-2xl bg-gray-100 dark:bg-[#2C201A]"
                 href="/shop?category=<%= cat._id %>">
                <img alt="<%= cat.name %>"
                     class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                     src="<%= cat.image ? '/uploads/catagory/' + cat.image : '/images/category-placeholder.jpg' %>"/>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-4 flex flex-col justify-end">
                  <h3 class="text-white text-lg font-bold"><%= cat.name %></h3>
                  <p class="text-white/80 text-xs font-body opacity-0 group-hover:opacity-100 transition-opacity translate-y-2 group-hover:translate-y-0 duration-300">
                    <%= cat.description ? cat.description : "Curated for perfection" %>
                  </p>
                </div>
              </a>
            <% }); %>
          </div>

          <% if (categories.length > 4) { %>
            <button type="button" id="categoryPrev" aria-label="Previous categories"
                    class="hidden md:flex absolute -left-4 top-1/2 -translate-y-1/2 size-10 rounded-full bg-white dark:bg-[#2C201A] shadow-md border border-[#E6E0DC] dark:border-[#3E302A] items-center justify-center hover:bg-primary hover:text-white transition-colors">
              <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <button type="button" id="categoryNext" aria-label="Next categories"
                    class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 size-10 rounded-full bg-white dark:bg-[#2C201A] shadow-md border border-[#E6E0DC] dark:border-[#3E302A] items-center justify-center hover:bg-primary hover:text-white transition-colors">
              <span class="material-symbols-outlined">chevron_right</span>
            </button>
          <% } %>
        </div>
      <% } else { %>
        <p class="text-[#886e63] font-body">No categories to show yet.</p>
      <% } %>
    </div>
  </section>

  <!-- NEW ARRIVALS: now loops over `products` -->
  <section class="px-6 py-16 lg:px-20 xl:px-40 bg-[#F5F0EB] dark:bg-background-dark/50">
    <div class="mx-auto max-w-[1280px]">
      <div class="text-center mb-12">
        <span class="text-primary font-bold tracking-widest text-sm uppercase">Just Arrived</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-[#181311] dark:text-white mt-2">Fresh From The Market</h2>
      </div>

      <% if (products && products.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <% products.slice(0, 4).forEach(function(product) {
               // Adjust these field lookups to match your actual Product schema.
               var variant   = (product.variants && product.variants.length > 0) ? product.variants[0] : {};
               var price     = variant.salePrice || variant.price || 0;
               var mrp       = variant.price || null;
               var outOfStock = !variant.stock || variant.stock <= 0;
               var image     = (product.images && product.images.length > 0) ? product.images[0] : "/images/product-placeholder.jpg";
          %>
            <div class="group flex flex-col gap-4">
              <div class="relative aspect-square bg-white dark:bg-[#2C201A] rounded-2xl overflow-hidden shadow-sm transition-shadow hover:shadow-lg">
                <% if (product.isOrganic) { %>
                  <div class="absolute top-3 left-3 bg-forest text-white text-xs font-bold px-2 py-1 rounded">Organic</div>
                <% } else if (product.isBestseller) { %>
                  <div class="absolute top-3 left-3 bg-secondary text-white text-xs font-bold px-2 py-1 rounded">Bestseller</div>
                <% } %>

                <img alt="<%= product.productName %>"
                     class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  src="<%= product.images && product.images.length > 0 ? '/uploads/product/' + product.images[0] : '/images/product-placeholder.jpg' %>"

                <% if (outOfStock) { %>
                  <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                    <span class="text-white font-bold text-sm uppercase tracking-wide">Out of Stock</span>
                  </div>
                <% } else { %>
                  <button type="button"
                          class="add-to-cart-btn absolute bottom-3 right-3 size-10 bg-white dark:bg-[#3E302A] dark:text-white text-primary rounded-full shadow-md flex items-center justify-center translate-y-16 group-hover:translate-y-0 transition-transform duration-300 hover:bg-primary hover:text-white"
                          data-product-id="<%= product._id %>">
                    <span class="material-symbols-outlined text-[20px]">add_shopping_cart</span>
                  </button>
                <% } %>
              </div>
              <div>
                <a href="/product/<%= product._id %>" class="text-lg font-bold text-[#181311] dark:text-white group-hover:text-primary transition-colors">
                  <%= product.productName %>
                </a>
                <p class="text-[#886e63] dark:text-[#9CA3AF] text-sm font-body mb-2">
                  <%= product.origin ? product.origin + " • " : "" %><%= variant.size ? variant.size : "" %>
                </p>
                <p class="text-primary font-bold text-lg">
                  ₹<%= price %>
                  <% if (mrp && mrp > price) { %>
                    <span class="text-[#886e63] text-sm font-normal line-through ml-1">₹<%= mrp %></span>
                  <% } %>
                </p>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="text-center text-[#886e63] font-body">No products available right now — check back soon.</p>
      <% } %>
    </div>
  </section>

  <!-- TESTIMONIALS: loops over `testimonials`; falls back to a static quote if none are passed -->
  <section class="px-6 py-20 lg:px-20 xl:px-40 bg-white dark:bg-[#1A120E]">
    <div class="mx-auto max-w-[1280px]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-primary font-bold tracking-widest text-sm uppercase">Community Love</span>
          <h2 class="text-3xl lg:text-4xl font-bold mt-2 mb-8 text-[#181311] dark:text-white">What our chefs say</h2>

          <% var t = (testimonials && testimonials.length > 0) ? testimonials[0] : {
               rating: 5,
               quote: "The aroma when I opened the jar was incredible. Nothing like store-bought. You can truly taste the difference in freshness and potency.",
               name: "Sarah Jenkins",
               role: "Home Chef",
               avatar: "/images/avatar-placeholder.jpg"
             }; %>

          <div class="relative p-8 rounded-2xl bg-[#f8f6f6] dark:bg-[#2C201A] border border-transparent dark:border-[#3E302A]">
            <span class="material-symbols-outlined absolute top-6 left-6 text-4xl text-[#D6CFC7] dark:text-[#3E302A] z-0">format_quote</span>
            <div class="relative z-10">
              <div class="flex gap-1 mb-4 text-secondary">
                <% for (var i = 0; i < 5; i++) { %>
                  <span class="material-symbols-outlined fill-current" style="font-variation-settings: 'FILL' <%= i < t.rating ? 1 : 0 %>">star</span>
                <% } %>
              </div>
              <p class="text-lg lg:text-xl font-body italic text-[#4A4A4A] dark:text-[#D1D5DB] mb-6">
                "<%= t.quote %>"
              </p>
              <div class="flex items-center gap-4">
                <div class="size-12 rounded-full bg-gray-300 overflow-hidden">
                  <img alt="<%= t.name %>" class="w-full h-full object-cover" src="<%= "images/default.png" %>"/>
                </div>
                <div>
                  <p class="font-bold text-[#181311] dark:text-white"><%= t.name %></p>
                  <p class="text-sm text-[#886e63]"><%= t.role %></p>
                </div>
              </div>
            </div>
          </div>

          <% if (testimonials && testimonials.length > 1) { %>
            <div class="flex gap-2 mt-6 justify-center lg:justify-start">
              <button type="button" id="testimonial-prev" class="size-10 rounded-full border border-[#E6E0DC] flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-colors">
                <span class="material-symbols-outlined">arrow_back</span>
              </button>
              <button type="button" id="testimonial-next" class="size-10 rounded-full border border-[#E6E0DC] flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-colors">
                <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </div>
          <% } %>
        </div>

       
      </div>
    </div>
  </section>

</main>
<%- include("../partials/footer") %>
</div>

<script>
  // Category slider prev/next
  var categorySlider = document.getElementById("categorySlider");
  var categoryPrev = document.getElementById("categoryPrev");
  var categoryNext = document.getElementById("categoryNext");
  if (categorySlider && categoryPrev && categoryNext) {
    var categoryScrollAmount = function () {
      var card = categorySlider.querySelector("a");
      return card ? card.offsetWidth + 24 : 300;
    };
    categoryPrev.addEventListener("click", function () {
      categorySlider.scrollBy({ left: -categoryScrollAmount(), behavior: "smooth" });
    });
    categoryNext.addEventListener("click", function () {
      categorySlider.scrollBy({ left: categoryScrollAmount(), behavior: "smooth" });
    });
  }

  // Click-and-drag support for mouse users (touch/trackpad already scroll natively)
  if (categorySlider) {
    var isDown = false;
    var startX = 0;
    var scrollStart = 0;

    categorySlider.addEventListener("mousedown", function (e) {
      isDown = true;
      categorySlider.classList.add("cursor-grabbing");
      startX = e.pageX;
      scrollStart = categorySlider.scrollLeft;
    });

    window.addEventListener("mouseup", function () {
      isDown = false;
      categorySlider.classList.remove("cursor-grabbing");
    });

    categorySlider.addEventListener("mouseleave", function () {
      isDown = false;
      categorySlider.classList.remove("cursor-grabbing");
    });

    categorySlider.addEventListener("mousemove", function (e) {
      if (!isDown) return;
      e.preventDefault();
      var walk = e.pageX - startX;
      categorySlider.scrollLeft = scrollStart - walk;
    });
  }

  // Add-to-cart buttons — wire up to your existing cart endpoint.
  document.querySelectorAll(".add-to-cart-btn").forEach(function (btn) {
    btn.addEventListener("click", async function () {
      var productId = btn.dataset.productId;
      try {
        var res = await fetch("/cart/add", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ productId: productId })
        });
        var data = await res.json();
        if (data.success) {
          Swal.fire({ icon: "success", title: "Added to cart", timer: 1200, showConfirmButton: false });
        } else {
          Swal.fire({ icon: "error", title: data.message || "Could not add to cart" });
        }
      } catch (err) {
        Swal.fire({ icon: "error", title: "Something went wrong" });
      }
    });
  });

  // Newsletter subscribe form
  var newsletterForm = document.getElementById("newsletter-form");
  if (newsletterForm) {
    newsletterForm.addEventListener("submit", async function (e) {
      e.preventDefault();
      var email = newsletterForm.email.value;
      try {
        var res = await fetch("/newsletter/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email })
        });
        var data = await res.json();
        Swal.fire({
          icon: data.success ? "success" : "error",
          title: data.success ? "Subscribed!" : (data.message || "Subscription failed")
        });
        if (data.success) newsletterForm.reset();
      } catch (err) {
        Swal.fire({ icon: "error", title: "Something went wrong" });
      }
    });
  }
</script>

</body></html>
