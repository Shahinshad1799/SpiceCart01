<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Order #<%= order._id.toString().slice(-6).toUpperCase() %></title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<!-- SweetAlert2 -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: "class",
    theme: {
      extend: {
        colors: {
          "border-subtle": "#E6E0DC",
          "text-muted": "#886e63",
          "forest-green": "#4C5E4E",
          "background-light": "#f8f6f6",
          "surface-card": "#ffffff",
          "surface-muted": "#f4f1f0",
          "accent-gold": "#B89F73",
          "text-main": "#181311",
          "background-dark": "#211611",
          "primary": "#cd4e18"
        },
        borderRadius: {
          "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1.25rem", "full": "9999px"
        },
        fontFamily: {
          "body": ["Manrope", "sans-serif"],
          "display": ["Epilogue", "sans-serif"]
        },
        boxShadow: {
          "premium": "0 10px 30px -5px rgba(24,19,17,0.03), 0 4px 12px -3px rgba(24,19,17,0.02)"
        }
      },
    },
  }
</script>
<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  body { font-family: 'Manrope', sans-serif; }
  h1, h2, h3, h4, .font-display { font-family: 'Epilogue', sans-serif; }

  /* ── SweetAlert2 custom theme ── */
  .swal2-popup {
    font-family: 'Manrope', sans-serif !important;
    border-radius: 1.25rem !important;
    padding: 2rem !important;
  }
  .swal2-title {
    font-family: 'Epilogue', sans-serif !important;
    font-size: 1.25rem !important;
    color: #181311 !important;
  }
  .swal2-html-container {
    font-size: 0.875rem !important;
    color: #886e63 !important;
  }
  .swal2-confirm {
    background-color: #ef4444 !important;
    border-radius: 0.75rem !important;
    font-family: 'Manrope', sans-serif !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    padding: 0.75rem 1.5rem !important;
    box-shadow: none !important;
  }
  .swal2-cancel {
    background-color: #f4f1f0 !important;
    color: #181311 !important;
    border-radius: 0.75rem !important;
    font-family: 'Manrope', sans-serif !important;
    font-weight: 700 !important;
    font-size: 0.875rem !important;
    padding: 0.75rem 1.5rem !important;
    box-shadow: none !important;
  }
  .swal2-cancel:hover { background-color: #E6E0DC !important; }
  .swal2-icon.swal2-warning { border-color: #ef4444 !important; color: #ef4444 !important; }
  .swal2-icon.swal2-success { border-color: #22c55e !important; }
  .swal2-icon.swal2-success [class^='swal2-success-line'] { background: #22c55e !important; }
  .swal2-icon.swal2-success .swal2-success-ring { border-color: #bbf7d0 !important; }
  /* reason select inside swal */
  #swal-cancel-reason {
    width: 100%;
    margin-top: 1rem;
    padding: 0.65rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid #E6E0DC;
    background: #f4f1f0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.85rem;
    color: #181311;
    outline: none;
    cursor: pointer;
  }
  #swal-cancel-reason:focus { border-color: #cd4e18; box-shadow: 0 0 0 3px rgba(205,78,24,0.15); }

  /* ── Print / Invoice styles ── */
  @media print {
    body * { visibility: hidden !important; }
    #invoice-printable, #invoice-printable * { visibility: visible !important; }
    #invoice-printable {
      position: fixed !important; inset: 0 !important;
      width: 100vw !important; height: auto !important;
      background: #fff !important; padding: 2.5rem !important;
      z-index: 99999 !important; display: block !important;
    }
  }
</style>
</head>
<body class="bg-background-light dark:bg-background-dark text-text-main dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">

  <%- include("../partials/header") %>

  <main class="flex-1 bg-[#fbf9f8] dark:bg-[#1A120E]">
    <section class="px-6 py-12 lg:px-20 xl:px-40">
      <div class="mx-auto max-w-[1280px]">

        <!-- Breadcrumb -->
        <div class="mb-10 flex items-center gap-2 text-[13px] text-text-muted dark:text-[#9CA3AF]">
          <a class="hover:text-primary" href="/">Home</a>
          <span class="material-symbols-outlined text-[10px]">chevron_right</span>
          <a class="hover:text-primary" href="/order">My Orders</a>
          <span class="material-symbols-outlined text-[10px]">chevron_right</span>
          <span class="text-text-main dark:text-white font-semibold">Order #<%= order._id.toString().slice(-6).toUpperCase() %></span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

          <!-- ── SIDEBAR ── -->
          <aside class="lg:col-span-4 xl:col-span-3 space-y-6">
            <div class="bg-white dark:bg-[#2C201A] rounded-2xl p-8 shadow-premium border border-border-subtle dark:border-[#3E302A]">
              <div class="flex flex-col items-center text-center">
                <div class="relative mb-6 group cursor-pointer">
                  <div class="size-28 rounded-full overflow-hidden border-4 border-[#f8f6f6] dark:border-[#1A120E] shadow-inner">
                    <% if (user.profileImage) { %>
                      <img alt="<%= user.name %>" class="w-full h-full object-cover" src="/uploads/profile/<%= user.profileImage %>"/>
                    <% } else { %>
                      <div class="w-full h-full bg-primary/10 flex items-center justify-center">
                        <span class="material-symbols-outlined text-5xl text-primary">person</span>
                      </div>
                    <% } %>
                  </div>
                </div>
                <h3 class="text-xl font-bold text-text-main dark:text-white mb-1"><%= user.name %></h3>
                <p class="text-sm text-text-muted dark:text-[#9CA3AF] mb-8">
                  Member since <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                </p>
                <a href="/profile" class="w-full">
                  <button class="w-full py-3 rounded-xl border border-border-subtle dark:border-[#3E302A] font-bold text-text-main dark:text-white hover:bg-surface-muted dark:hover:bg-[#3E302A] transition-all text-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">settings</span>
                    Manage Account
                  </button>
                </a>
              </div>
              <div class="space-y-4 mt-10 pt-8 border-t border-[#f4f1f0] dark:border-[#3E302A]">
                <div class="flex items-center justify-between">
                  <span class="text-[13px] text-text-muted dark:text-[#9CA3AF] font-medium">Total Orders</span>
                  <span class="text-[13px] font-bold text-text-main dark:text-white"><%= totalOrders %></span>
                </div>
              </div>
            </div>
          </aside>

          <!-- ── ORDER CONTENT ── -->
          <div class="lg:col-span-8 xl:col-span-9 space-y-8">
            <div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-premium border border-border-subtle dark:border-[#3E302A] overflow-hidden">

              <%
                const statusMap = {
                  pending:    { bg: 'bg-amber-50',  text: 'text-amber-600',  border: 'border-amber-100', label: 'Pending',     step: 1 },
                  processing: { bg: 'bg-amber-50',  text: 'text-amber-600',  border: 'border-amber-100', label: 'Processing',  step: 2 },
                  shipped:    { bg: 'bg-blue-50',   text: 'text-blue-600',   border: 'border-blue-100',  label: 'In Transit',  step: 3 },
                  delivered:  { bg: 'bg-green-50',  text: 'text-green-600',  border: 'border-green-100', label: 'Delivered',   step: 4 },
                  cancelled:  { bg: 'bg-red-50',    text: 'text-red-500',    border: 'border-red-100',   label: 'Cancelled',   step: 0 },
                };
                const badge = statusMap[order.status] || statusMap['pending'];
                const step  = badge.step;
                const progressWidth = { 0: '0%', 1: '0%', 2: '33%', 3: '66%', 4: '100%' };
              %>

              <!-- Header -->
              <div class="px-8 py-10 lg:px-12 border-b border-[#f4f1f0] dark:border-[#3E302A]">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                  <div>
                    <div class="flex items-center gap-4 mb-3">
                      <h1 class="text-3xl font-bold tracking-tight text-text-main dark:text-white">
                        Order #<%= order._id.toString().slice(-6).toUpperCase() %>
                      </h1>
                      <span class="px-3 py-1 text-[11px] font-bold <%= badge.bg %> <%= badge.text %> rounded-lg border <%= badge.border %> uppercase tracking-wider">
                        <%= badge.label %>
                      </span>
                    </div>
                    <p class="text-sm text-text-muted dark:text-[#9CA3AF]">
                      Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      at <%= new Date(order.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                    </p>
                  </div>
                  <div class="flex flex-wrap items-center gap-3">
                    <!-- Contact Support -->
                    <a href="mailto:support@spicemarket.com?subject=Order%20%23<%= order._id.toString().slice(-6).toUpperCase() %>&body=Hi%2C%20I%20need%20help%20with%20my%20order%20%23<%= order._id %>">
                      <button class="px-5 py-2.5 text-xs font-bold text-text-main dark:text-white bg-surface-muted dark:bg-[#3E302A] hover:bg-border-subtle dark:hover:bg-[#4a3a33] rounded-xl transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-lg">support_agent</span> Contact Support
                      </button>
                    </a>
                    <!-- Cancel button — only if order is pending -->
                   <!-- Cancel button -->
<% if (order.status === 'pending') { %>
<button
  onclick="openCancelModal('<%= order._id %>')"
  class="px-5 py-2.5 text-xs font-bold text-red-500/80 hover:bg-red-50/50 dark:hover:bg-red-950/20 rounded-xl transition-all flex items-center gap-2">
  <span class="material-symbols-outlined text-lg">cancel</span>
  Cancel Order
</button>
<% } %>

<!-- Return button -->
<% if (order.status === 'delivered') { %>
<button
  onclick="openReturnModal('<%= order._id %>')"
  class="px-5 py-2.5 text-xs font-bold text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/20 rounded-xl transition-all flex items-center gap-2">
  <span class="material-symbols-outlined text-lg">keyboard_return</span>
  Return Order
</button>
<% } %>
                  </div>
                </div>
              </div>

              <!-- Timeline -->
              <% if (order.status !== 'cancelled') { %>
              <div class="px-8 py-14 lg:px-16 bg-[#fcfbfb] dark:bg-[#261c17] border-b border-[#f4f1f0] dark:border-[#3E302A]">
                <div class="relative max-w-4xl mx-auto">
                  <div class="absolute top-4 left-[2%] right-[2%] h-[3px] bg-border-subtle dark:bg-[#3E302A]"></div>
                  <div class="absolute top-4 left-[2%] h-[3px] bg-primary transition-all duration-700" style="width: <%= progressWidth[step] %>"></div>
                  <div class="flex justify-between items-start relative z-10">
                    <div class="flex flex-col items-center">
                      <div class="size-8 rounded-full flex items-center justify-center ring-[6px] ring-white dark:ring-[#2C201A] shadow-sm <%= step >= 1 ? 'bg-primary' : 'bg-border-subtle dark:bg-[#3E302A]' %>">
                        <span class="material-symbols-outlined text-white text-base">check</span>
                      </div>
                      <div class="mt-4 text-center">
                        <p class="text-[12px] font-bold <%= step >= 1 ? 'text-text-main dark:text-white' : 'text-text-muted' %>">Ordered</p>
                        <p class="text-[10px] text-text-muted mt-0.5">
                          <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                        </p>
                      </div>
                    </div>
                    <div class="flex flex-col items-center <%= step < 2 ? 'opacity-40' : '' %>">
                      <div class="size-8 rounded-full flex items-center justify-center ring-[6px] ring-white dark:ring-[#2C201A] shadow-sm <%= step >= 2 ? 'bg-primary' : 'bg-border-subtle dark:bg-[#3E302A]' %>">
                        <span class="material-symbols-outlined text-white text-base">inventory_2</span>
                      </div>
                      <div class="mt-4 text-center">
                        <p class="text-[12px] font-bold <%= step === 2 ? 'text-primary' : 'text-text-muted dark:text-white' %>">Processing</p>
                        <p class="text-[10px] text-text-muted mt-0.5"><%= step >= 2 ? '' : 'Pending' %></p>
                      </div>
                    </div>
                    <div class="flex flex-col items-center <%= step < 3 ? 'opacity-40' : '' %>">
                      <div class="<%= step === 3 ? 'size-10 -mt-1' : 'size-8' %> rounded-full flex items-center justify-center ring-[6px] <%= step === 3 ? 'ring-[8px]' : '' %> ring-white dark:ring-[#2C201A] shadow-sm <%= step >= 3 ? 'bg-primary' : 'bg-border-subtle dark:bg-[#3E302A]' %>">
                        <span class="material-symbols-outlined text-white <%= step === 3 ? 'text-lg' : 'text-base' %>">local_shipping</span>
                      </div>
                      <div class="mt-4 text-center">
                        <p class="text-[12px] font-bold <%= step === 3 ? 'text-primary' : 'text-text-muted' %>">Shipped</p>
                        <p class="text-[10px] text-text-muted mt-0.5"><%= step >= 3 ? '' : 'Pending' %></p>
                      </div>
                    </div>
                    <div class="flex flex-col items-center <%= step < 4 ? 'opacity-40' : '' %>">
                      <div class="size-8 rounded-full flex items-center justify-center ring-[6px] ring-white dark:ring-[#2C201A] shadow-sm <%= step >= 4 ? 'bg-primary' : 'bg-border-subtle dark:bg-[#3E302A]' %>">
                        <span class="material-symbols-outlined <%= step >= 4 ? 'text-white' : 'text-text-muted' %> text-base">home</span>
                      </div>
                      <div class="mt-4 text-center">
                        <p class="text-[12px] font-bold <%= step === 4 ? 'text-primary' : 'text-text-muted' %>">Delivered</p>
                        <p class="text-[10px] text-text-muted mt-0.5"><%= step >= 4 ? '' : 'Pending' %></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% } %>

              <!-- Details Grid -->
              <div class="p-8 lg:p-12">
                <div class="grid grid-cols-1 xl:grid-cols-12 gap-12">

                  <!-- ── ITEMS LIST ── -->
                  <div class="xl:col-span-7 space-y-8">
                    <div class="flex items-center justify-between mb-2">
                      <h3 class="text-xl font-bold text-text-main dark:text-white">Order Items</h3>
                      <!-- ✅ Invoice download button -->
                      <button
                        onclick="downloadInvoice()"
                        class="text-sm font-bold text-primary flex items-center gap-1.5 hover:opacity-80 transition-opacity">
                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                        <span>Invoice</span>
                      </button>
                    </div>
                    <div class="space-y-5">
                      <% order.items.forEach(item => { %>
                      <div class="flex items-center gap-6 p-5 rounded-2xl hover:bg-[#fcfbfb] dark:hover:bg-[#32241E] transition-all border border-border-subtle/50 dark:border-[#3E302A]/50">
                        <div class="size-24 rounded-xl overflow-hidden bg-white border border-border-subtle dark:border-[#3E302A] flex-shrink-0 shadow-sm">
                          <% if (item.productImage) { %>
                            <img alt="<%= item.productName %>" class="w-full h-full object-cover" src="/uploads/product/<%= item.productImage %>"/>
                          <% } else { %>
                            <div class="w-full h-full bg-surface-muted flex items-center justify-center">
                              <span class="material-symbols-outlined text-text-muted text-3xl">inventory_2</span>
                            </div>
                          <% } %>
                        </div>
                        <div class="flex-1">
                          <div class="flex justify-between items-start">
                            <div>
                              <p class="font-bold text-lg text-text-main dark:text-white"><%= item.productName %></p>
                            </div>
                            <p class="font-bold text-lg text-text-main dark:text-white">₹<%= item.lineTotal.toFixed(2) %></p>
                          </div>
                          <div class="mt-4 flex items-center gap-4 text-xs font-semibold text-text-muted">
                            <span class="bg-surface-muted dark:bg-[#3E302A] px-2 py-1 rounded">
                              Qty: <span class="text-text-main dark:text-white"><%= item.quantity %></span>
                            </span>
                            <span class="size-1 rounded-full bg-border-subtle"></span>
                            <span>₹<%= item.unitPrice.toFixed(2) %> per unit</span>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                    </div>
                  </div>

                  <!-- ── RIGHT COLUMN ── -->
                  <div class="xl:col-span-5 space-y-8">

                    <!-- Order Summary -->
                    <div class="bg-surface-muted dark:bg-[#261C16] rounded-2xl p-8 border border-border-subtle dark:border-[#3E302A] shadow-sm">
                      <h3 class="font-bold text-text-main dark:text-white mb-8 text-sm uppercase tracking-[0.15em]">Order Summary</h3>
                      <div class="space-y-5">
                        <div class="flex justify-between text-sm">
                          <span class="text-text-muted font-medium">Subtotal</span>
                          <span class="font-bold text-text-main dark:text-white">₹<%= order.subtotal.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between text-sm">
                          <span class="text-text-muted font-medium">Shipping</span>
                          <span class="font-bold text-text-main dark:text-white">
                            <%= order.shipping === 0 ? 'Free' : '₹' + order.shipping.toFixed(2) %>
                          </span>
                        </div>
                        <div class="flex justify-between text-sm">
                          <span class="text-text-muted font-medium">Tax (5%)</span>
                          <span class="font-bold text-text-main dark:text-white">₹<%= order.tax.toFixed(2) %></span>
                        </div>
                        <div class="pt-6 border-t border-border-subtle dark:border-[#3E302A] flex justify-between items-end">
                          <span class="text-base font-extrabold text-text-main dark:text-white">Total Amount</span>
                          <span class="text-3xl font-bold text-primary tracking-tight font-display">₹<%= order.total.toFixed(2) %></span>
                        </div>
                      </div>
                    </div>

                    <!-- Shipping Address -->
                    <div class="p-6 rounded-2xl border border-border-subtle dark:border-[#3E302A] bg-white dark:bg-[#2C201A] shadow-sm">
                      <p class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-4">Shipping Destination</p>
                      <p class="text-sm font-bold text-text-main dark:text-white mb-2"><%= order.shippingAddress.fullname %></p>
                      <p class="text-xs text-text-muted leading-relaxed">
                        <%= order.shippingAddress.address %>, <%= order.shippingAddress.appartment %><br/>
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zipcode %>
                      </p>
                      <p class="text-xs text-text-muted mt-2"><%= order.shippingAddress.phonenumber %></p>
                    </div>

                    <!-- Payment -->
                    <div class="p-6 rounded-2xl border border-border-subtle dark:border-[#3E302A] bg-white dark:bg-[#2C201A] shadow-sm">
                      <p class="text-[10px] font-bold text-text-muted uppercase tracking-widest mb-4">Payment Information</p>
                      <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-text-muted">payments</span>
                        <p class="text-sm font-bold text-text-main dark:text-white capitalize">
                          <%= order.paymentMethod.replace(/_/g, ' ') %>
                        </p>
                      </div>
                      <div class="mt-3 flex items-center gap-2">
                        <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold
                          <%= order.paymentStatus === 'paid' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                          <%= order.paymentStatus.toUpperCase() %>
                        </span>
                      </div>
                    </div>

                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>
</div>


<!-- SweetAlert2 handles the cancel modal — no HTML needed here -->


<!-- ════════════════════════════════════════════
     HIDDEN PRINTABLE INVOICE
════════════════════════════════════════════ -->
<div id="invoice-printable" style="display:none; font-family:'Manrope',sans-serif; color:#181311; background:#fff; padding:2.5rem; max-width:720px; margin:0 auto;">

  <!-- Invoice Header -->
  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:2rem; padding-bottom:1.5rem; border-bottom:2px solid #E6E0DC;">
    <div>
      <div style="font-family:'Epilogue',sans-serif; font-size:1.6rem; font-weight:800; color:#cd4e18; letter-spacing:-0.03em;">🌶 Spice Market</div>
      <div style="font-size:0.75rem; color:#886e63; margin-top:0.25rem;">support@spicemarket.com</div>
    </div>
    <div style="text-align:right;">
      <div style="font-size:1.1rem; font-weight:700; color:#181311;">INVOICE</div>
      <div style="font-size:0.8rem; color:#886e63; margin-top:0.25rem;">#<%= order._id.toString().slice(-6).toUpperCase() %></div>
      <div style="font-size:0.75rem; color:#886e63; margin-top:0.1rem;">
        <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
      </div>
    </div>
  </div>

  <!-- Billing / Shipping info -->
  <div style="display:flex; gap:2rem; margin-bottom:2rem;">
    <div style="flex:1;">
      <div style="font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#886e63; margin-bottom:0.5rem;">Bill To</div>
      <div style="font-weight:700; font-size:0.9rem;"><%= user.name %></div>
      <div style="font-size:0.8rem; color:#886e63; margin-top:0.2rem;"><%= user.email %></div>
    </div>
    <div style="flex:1;">
      <div style="font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#886e63; margin-bottom:0.5rem;">Ship To</div>
      <div style="font-weight:700; font-size:0.9rem;"><%= order.shippingAddress.fullname %></div>
      <div style="font-size:0.8rem; color:#886e63; line-height:1.5; margin-top:0.2rem;">
        <%= order.shippingAddress.address %>, <%= order.shippingAddress.appartment %><br/>
        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zipcode %>
      </div>
    </div>
    <div style="flex:1;">
      <div style="font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; color:#886e63; margin-bottom:0.5rem;">Payment</div>
      <div style="font-weight:700; font-size:0.9rem; text-transform:capitalize;"><%= order.paymentMethod.replace(/_/g, ' ') %></div>
      <div style="display:inline-block; margin-top:0.4rem; padding:0.15rem 0.5rem; border-radius:0.25rem; font-size:0.65rem; font-weight:700;
        background:<%= order.paymentStatus === 'paid' ? '#dcfce7' : '#fef3c7' %>;
        color:<%= order.paymentStatus === 'paid' ? '#15803d' : '#b45309' %>;">
        <%= order.paymentStatus.toUpperCase() %>
      </div>
    </div>
  </div>

  <!-- Items Table -->
  <table style="width:100%; border-collapse:collapse; margin-bottom:1.5rem;">
    <thead>
      <tr style="background:#f4f1f0;">
        <th style="text-align:left; padding:0.75rem 1rem; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#886e63; font-weight:700;">Item</th>
        <th style="text-align:center; padding:0.75rem 1rem; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#886e63; font-weight:700;">Qty</th>
        <th style="text-align:right; padding:0.75rem 1rem; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#886e63; font-weight:700;">Unit Price</th>
        <th style="text-align:right; padding:0.75rem 1rem; font-size:0.7rem; text-transform:uppercase; letter-spacing:0.1em; color:#886e63; font-weight:700;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% order.items.forEach((item, i) => { %>
      <tr style="border-bottom:1px solid #E6E0DC; background:<%= i % 2 === 0 ? '#fff' : '#fbf9f8' %>;">
        <td style="padding:0.85rem 1rem; font-size:0.85rem; font-weight:600; color:#181311;"><%= item.productName %></td>
        <td style="padding:0.85rem 1rem; font-size:0.85rem; text-align:center; color:#886e63;"><%= item.quantity %></td>
        <td style="padding:0.85rem 1rem; font-size:0.85rem; text-align:right; color:#886e63;">₹<%= item.unitPrice.toFixed(2) %></td>
        <td style="padding:0.85rem 1rem; font-size:0.85rem; text-align:right; font-weight:700; color:#181311;">₹<%= item.lineTotal.toFixed(2) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- Totals -->
  <div style="display:flex; justify-content:flex-end; margin-bottom:2rem;">
    <div style="width:260px;">
      <div style="display:flex; justify-content:space-between; padding:0.5rem 0; border-bottom:1px solid #E6E0DC;">
        <span style="font-size:0.82rem; color:#886e63;">Subtotal</span>
        <span style="font-size:0.82rem; font-weight:700;">₹<%= order.subtotal.toFixed(2) %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:0.5rem 0; border-bottom:1px solid #E6E0DC;">
        <span style="font-size:0.82rem; color:#886e63;">Shipping</span>
        <span style="font-size:0.82rem; font-weight:700;"><%= order.shipping === 0 ? 'Free' : '₹' + order.shipping.toFixed(2) %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:0.5rem 0; border-bottom:1px solid #E6E0DC;">
        <span style="font-size:0.82rem; color:#886e63;">Tax (5%)</span>
        <span style="font-size:0.82rem; font-weight:700;">₹<%= order.tax.toFixed(2) %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:0.75rem 0; margin-top:0.25rem;">
        <span style="font-size:1rem; font-weight:800; color:#181311;">Total</span>
        <span style="font-size:1.4rem; font-weight:800; color:#cd4e18; font-family:'Epilogue',sans-serif;">₹<%= order.total.toFixed(2) %></span>
      </div>
    </div>
  </div>

  <!-- Footer note -->
  <div style="border-top:1px solid #E6E0DC; padding-top:1.25rem; text-align:center; font-size:0.72rem; color:#886e63; line-height:1.6;">
    Thank you for shopping with Spice Market! For questions, contact support@spicemarket.com<br/>
    This is a computer-generated invoice and does not require a signature.
  </div>
</div>


<!-- ════════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════════ -->
<script>
  /* ─────────────────────────────
     CANCEL ORDER — SweetAlert2
  ───────────────────────────── */
  async function openCancelModal(orderId) {

    // ── Step 1: Pick a reason ──
    const { value: reason, isConfirmed: pickedReason } = await Swal.fire({
      title: 'Why are you cancelling?',
      html: `
        <p style="margin-bottom:0.75rem;font-size:0.875rem;color:#886e63;">
          Please select a reason so we can improve your experience.
        </p>
        <select id="swal-cancel-reason">
          <option value="" disabled selected>Select a reason…</option>
          <option value="changed_mind">Changed my mind</option>
          <option value="wrong_item">Ordered the wrong item</option>
          <option value="better_price">Found a better price elsewhere</option>
          <option value="delivery_too_long">Delivery is taking too long</option>
          <option value="other">Other</option>
        </select>`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Continue',
      cancelButtonText:  'Go Back',
      preConfirm: () => {
        const val = document.getElementById('swal-cancel-reason').value;
        if (!val) {
          Swal.showValidationMessage('Please select a reason to continue.');
          return false;
        }
        return val;
      }
    });

    if (!pickedReason) return; // user hit "Go Back"

    // ── Step 2: Final confirmation ──
    const { isConfirmed } = await Swal.fire({
      title: 'Cancel this order?',
      html: `<p style="font-size:0.875rem;color:#886e63;line-height:1.6;">
               This action <strong style="color:#181311;">cannot be undone</strong>.<br/>
               Your order will be cancelled and a refund will be initiated if payment was made.
             </p>`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Yes, Cancel Order',
      cancelButtonText:  'Keep Order',
      reverseButtons: true,
    });

    if (!isConfirmed) return;

    // ── Step 3: API call with loading state ──
    Swal.fire({
      title: 'Cancelling…',
      text: 'Please wait a moment.',
      allowOutsideClick: false,
      allowEscapeKey: false,
      didOpen: () => Swal.showLoading()
    });

    try {
      const res  = await fetch(`/orders/${orderId}/cancel`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();

      if (data.success) {
        await Swal.fire({
          title: 'Order Cancelled',
          text: 'Your order has been successfully cancelled.',
          icon: 'success',
          confirmButtonText: 'OK',
          timer: 2500,
          timerProgressBar: true,
        });
        window.location.reload();
      } else {
        Swal.fire({
          title: 'Failed',
          text: data.message || 'Could not cancel the order. Please try again.',
          icon: 'error',
          confirmButtonText: 'Close'
        });
      }
    } catch (err) {
      Swal.fire({
        title: 'Error',
        text: 'Something went wrong. Please try again later.',
        icon: 'error',
        confirmButtonText: 'Close'
      });
    }
  }

  /* ─────────────────────────────
   RETURN ORDER — SweetAlert2
───────────────────────────── */
async function openReturnModal(orderId) {

  // ── Step 1: Pick a return reason ──
  const { value: reason, isConfirmed: pickedReason } = await Swal.fire({
    title: 'Why are you returning this order?',
    html: `
      <p style="margin-bottom:0.75rem;font-size:0.875rem;color:#886e63;">
        Please select a return reason.
      </p>
      <select id="swal-cancel-reason">
        <option value="" disabled selected>Select a reason…</option>
        <option value="damaged_product">Damaged Product</option>
        <option value="wrong_item">Wrong Item Delivered</option>
        <option value="quality_issue">Quality Issue</option>
        <option value="not_needed">No Longer Needed</option>
        <option value="other">Other</option>
      </select>`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Continue',
    cancelButtonText: 'Go Back',
    preConfirm: () => {
      const val = document.getElementById('swal-cancel-reason').value;

      if (!val) {
        Swal.showValidationMessage('Please select a reason.');
        return false;
      }

      return val;
    }
  });

  if (!pickedReason) return;

  // ── Step 2: Final confirmation ──
  const { isConfirmed } = await Swal.fire({
    title: 'Return this order?',
    html: `
      <p style="font-size:0.875rem;color:#886e63;line-height:1.6;">
        Your return request will be sent for approval.
      </p>`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, Return Order',
    cancelButtonText: 'Keep Order',
    reverseButtons: true,
  });

  if (!isConfirmed) return;

  // ── Step 3: API call ──
  Swal.fire({
    title: 'Submitting Return Request…',
    text: 'Please wait a moment.',
    allowOutsideClick: false,
    allowEscapeKey: false,
    didOpen: () => Swal.showLoading()
  });

  try {

    const res = await fetch(`/orders/${orderId}/return`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ reason })
    });

    const data = await res.json();

    if (data.success) {

      await Swal.fire({
        title: 'Return Requested',
        text: 'Your return request has been submitted.',
        icon: 'success',
        confirmButtonText: 'OK',
        timer: 2500,
        timerProgressBar: true,
      });

      window.location.reload();

    } else {

      Swal.fire({
        title: 'Failed',
        text: data.message || 'Could not process return request.',
        icon: 'error',
        confirmButtonText: 'Close'
      });

    }

  } catch (err) {

    Swal.fire({
      title: 'Error',
      text: 'Something went wrong. Please try again later.',
      icon: 'error',
      confirmButtonText: 'Close'
    });

  }
}


  /* ─────────────────────────────
     DOWNLOAD INVOICE
  ───────────────────────────── */
  function downloadInvoice() {
    // Show the hidden invoice element, trigger print, then hide again
    const el = document.getElementById('invoice-printable');
    el.style.display = 'block';

    // Small delay so browser paints the element before print dialog
    setTimeout(() => {
      window.print();
      // After dialog closes (or on cancel), hide again
      el.style.display = 'none';
    }, 100);
  }
</script>

</body>
</html>
