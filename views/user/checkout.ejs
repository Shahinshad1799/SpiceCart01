<!DOCTYPE html>
<html><head>
<meta charset="utf-8"/>
<link crossorigin="" href="https://fonts.gstatic.com/" rel="preconnect"/>
<link as="style" href="https://fonts.googleapis.com/css2?display=swap&family=Epilogue:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900" onload="this.rel='stylesheet'" rel="stylesheet"/>
<title>Spice Shop – Checkout</title>
<link href="data:image/x-icon;base64," rel="icon" type="image/x-icon"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
  .address-form-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .address-form-wrapper.open { grid-template-rows: 1fr; }
  .address-form-inner { overflow: hidden; }

  .addr-card {
    cursor: pointer;
    border: 2px solid #e5e7eb;
    transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
  }
  .addr-card:hover { border-color: #f97316; background: #fff7ed; }
  .addr-card.selected {
    border-color: #ea580c;
    background: #fff7ed;
    box-shadow: 0 0 0 3px rgba(234,88,12,0.12);
  }
  .check-ring {
    width: 20px; height: 20px; border-radius: 50%;
    border: 2px solid #d1d5db;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.18s, background 0.18s;
  }
  .addr-card.selected .check-ring { border-color: #ea580c; background: #ea580c; }
  .check-icon { display: none; }
  .addr-card.selected .check-icon { display: block; }

  .skeleton { animation: pulse 1.6s ease-in-out infinite; background: #f0ece9; border-radius: 10px; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

  .shake { animation: shake 0.4s ease; }
  @keyframes shake {
    0%,100%{transform:translateX(0)} 20%{transform:translateX(-6px)}
    40%{transform:translateX(6px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(4px)}
  }
  @keyframes slideDown {
    from{opacity:0;transform:translateY(-8px)} to{opacity:1;transform:translateY(0)}
  }
  .slide-down { animation: slideDown 0.3s ease; }

  /* Validation styles */
  .field-error {
    display: none;
    font-size: 0.72rem;
    color: #dc2626;
    margin-top: 5px;
    align-items: center;
    gap: 3px;
    animation: slideDown 0.2s ease;
  }
  .field-error.visible { display: flex; }

  input.invalid {
    outline: none;
    border: 1.5px solid #dc2626 !important;
    box-shadow: 0 0 0 3px rgba(220,38,38,0.10);
  }
  input.valid {
    border: 1.5px solid #16a34a !important;
    box-shadow: 0 0 0 3px rgba(22,163,74,0.08);
  }
  /* Only show green AFTER the field has been touched and blurred */
  input:not(.touched).valid {
    border: 1px solid #e5e7eb !important;
    box-shadow: none;
  }
</style>
</head>
<body>
<div class="relative flex h-auto min-h-screen w-full flex-col bg-white overflow-x-hidden" style='font-family: Epilogue, "Noto Sans", sans-serif;'>
<div class="layout-container flex h-full grow flex-col">

<%- include("../partials/header") %>

<div class="flex flex-1 justify-center py-10 px-5 md:px-10 lg:px-20 xl:px-40">
  <div class="layout-content-container flex flex-col max-w-[1080px] flex-1">
    <h1 class="text-[#181311] text-3xl md:text-4xl font-bold leading-tight mb-8">Checkout</h1>
    <div class="flex flex-col lg:flex-row gap-12">
      <div class="flex-1 flex flex-col gap-10">

        <!-- ══════════ SHIPPING ADDRESS ══════════ -->
        <section id="address-section">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-[#181311] text-white font-bold text-sm">1</div>
            <h2 class="text-[#181311] text-xl font-bold">Shipping Address</h2>
          </div>

          <div class="flex flex-col gap-3 mb-4">

            <% if (addresses && addresses.length > 0) { %>
              <% addresses.forEach(addr => { %>
                <div
                  class="addr-card rounded-xl p-4 <%= addr.isdefault ? 'selected' : '' %>"
                  data-id="<%= addr._id %>"
                  data-name="<%= addr.fullname %>"
                  data-address="<%= addr.address %>"
                  data-appartment="<%= addr.appartment %>"
                  data-city="<%= addr.city %>"
                  data-state="<%= addr.state %>"
                  data-zip="<%= addr.zipcode %>"
                  data-phone="<%= addr.phonenumber %>"
                  onclick="selectAddress('<%= addr._id %>')"
                >
                  <div class="flex items-start gap-3">
                    <div class="check-ring mt-0.5">
                      <svg class="check-icon" width="11" height="9">
                        <path d="M1 4L4 7L10 1" stroke="white" stroke-width="2"/>
                      </svg>
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 flex-wrap mb-0.5">
                        <span class="text-[#181311] font-semibold text-sm"><%= addr.fullname %></span>
                        <% if (addr.isdefault) { %>
                          <span class="text-[10px] font-bold bg-[#ea580c] text-white px-2 py-0.5 rounded-full">Default</span>
                        <% } %>
                      </div>
                      <p class="text-[#886e63] text-xs truncate"><%= addr.address %>, <%= addr.appartment %></p>
                      <p class="text-[#886e63] text-xs"><%= addr.city %>, <%= addr.state %> <%= addr.zipcode %></p>
                      <p class="text-[#886e63] text-xs"><%= addr.phonenumber %></p>
                    </div>

                    <button
                      onclick="event.stopPropagation(); openEditForm('<%= addr._id %>')"
                      class="flex items-center gap-1 text-xs font-semibold text-[#886e63] hover:text-[#ea580c] px-2 py-1.5 rounded-lg hover:bg-white transition-all flex-shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-base">edit</span>Edit
                    </button>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="mb-4 rounded-xl border-2 border-dashed border-[#e5e7eb] p-6 text-center">
                <span class="material-symbols-outlined text-4xl text-[#d1cac7] block mb-1">location_off</span>
                <p class="text-[#886e63] text-sm">No saved addresses yet. Add one below.</p>
              </div>
            <% } %>

          </div>

          <button id="add-new-btn"
            onclick="openAddForm()"
            class="w-full flex items-center justify-center gap-2 rounded-xl border-2 border-dashed border-[#e5e7eb] py-3.5 text-sm font-semibold text-[#886e63] hover:border-[#ea580c] hover:text-[#ea580c] hover:bg-[#fff7ed] transition-all">
            <span class="material-symbols-outlined text-lg">add_location_alt</span>
            Add a new address
          </button>

          <!-- Collapsible form -->
          <div id="address-form-wrapper" class="address-form-wrapper mt-4">
            <div class="address-form-inner">
              <div class="rounded-xl border border-[#e5e7eb] bg-[#fcfbfb] p-5">
                <div class="flex items-center justify-between mb-5">
                  <p id="form-title" class="text-[#181311] font-bold text-sm">New Shipping Address</p>
                  <button onclick="closeForm()" class="text-[#886e63] hover:text-[#181311] transition-colors">
                    <span class="material-symbols-outlined text-xl">close</span>
                  </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                  <!-- Full Name -->
                  <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-[#181311] mb-2">Full Name</label>
                    <input id="inp-name"
                      class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                      placeholder="Enter your full name" type="text"
                      oninput="liveValidate('inp-name')" onblur="markTouched(this)" />
                    <p id="err-name" class="field-error">
                      <span class="material-symbols-outlined" style="font-size:13px">error</span>
                      Full name is required.
                    </p>
                  </div>

                  <!-- Street Address -->
                  <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-[#181311] mb-2">Address</label>
                    <input id="inp-address"
                      class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                      placeholder="Street address" type="text"
                      oninput="liveValidate('inp-address')" onblur="markTouched(this)" />
                    <p id="err-address" class="field-error">
                      <span class="material-symbols-outlined" style="font-size:13px">error</span>
                      Street address is required.
                    </p>
                  </div>

                  <!-- Apartment -->
                  <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-[#181311] mb-2">Apartment / Flat No.</label>
                    <input id="inp-appartment"
                      class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                      placeholder="Apartment, suite, flat, etc." type="text"
                      oninput="liveValidate('inp-appartment')" onblur="markTouched(this)" />
                    <p id="err-appartment" class="field-error">
                      <span class="material-symbols-outlined" style="font-size:13px">error</span>
                      Apartment / Flat No. is required.
                    </p>
                  </div>

                  <!-- City -->
                  <div>
                    <label class="block text-sm font-medium text-[#181311] mb-2">City</label>
                    <input id="inp-city"
                      class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                      placeholder="City" type="text"
                      oninput="liveValidate('inp-city')" onblur="markTouched(this)" />
                    <p id="err-city" class="field-error">
                      <span class="material-symbols-outlined" style="font-size:13px">error</span>
                      City is required.
                    </p>
                  </div>

                  <!-- State + Zip -->
                  <div class="grid grid-cols-2 gap-4">
                    <div>
                      <label class="block text-sm font-medium text-[#181311] mb-2">State</label>
                      <input id="inp-state"
                        class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                        placeholder="State" type="text"
                        oninput="liveValidate('inp-state')" onblur="markTouched(this)" />
                      <p id="err-state" class="field-error">
                        <span class="material-symbols-outlined" style="font-size:13px">error</span>
                        State is required.
                      </p>
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-[#181311] mb-2">Zip</label>
                      <input id="inp-zip"
                        class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                        placeholder="Zip Code" type="text" maxlength="6"
                        oninput="liveValidate('inp-zip')" onblur="markTouched(this)" />
                      <p id="err-zip" class="field-error">
                        <span class="material-symbols-outlined" style="font-size:13px">error</span>
                        Enter a valid 6-digit zip code.
                      </p>
                    </div>
                  </div>

                  <!-- Phone -->
                  <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-[#181311] mb-2">Phone Number</label>
                    <input id="inp-phone"
                      class="w-full rounded-lg border-none bg-white border border-[#e5e7eb] p-4 text-[#181311] placeholder:text-[#886e63] focus:ring-2 focus:ring-[#ea580c] outline-none"
                      placeholder="9876543210" type="tel" maxlength="10"
                      oninput="liveValidate('inp-phone')" onblur="markTouched(this)" />
                    <p id="err-phone" class="field-error">
                      <span class="material-symbols-outlined" style="font-size:13px">error</span>
                      Enter a valid 10-digit phone number.
                    </p>
                  </div>

                </div>

                <div class="flex gap-3 mt-6">
                  <button id="save-btn" onclick="saveAddress()"
                    class="flex-1 bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold py-3 rounded-lg transition-colors text-sm flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-base">save</span> Save Address
                  </button>
                  <button onclick="closeForm()"
                    class="px-5 py-3 rounded-lg border border-[#e5e7eb] text-[#886e63] hover:text-[#181311] hover:border-[#181311] font-medium text-sm transition-all">
                    Cancel
                  </button>
                </div>

              </div>
            </div>
          </div>
        </section>

        <!-- ══════════ PAYMENT ══════════ -->
        <!-- <section>
          <div class="flex items-center gap-3 mb-6">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-[#181311] text-white font-bold text-sm">2</div>
            <h2 class="text-[#181311] text-xl font-bold">Payment Method</h2>
          </div>
          <div class="flex flex-col gap-4">
            <div class="flex gap-4 mb-2">
              <label class="flex items-center gap-3 cursor-pointer border border-[#ea580c] bg-[#fff7ed] rounded-xl p-4 w-1/2 transition-all">
<input checked="" class="w-5 h-5 text-[#ea580c] focus:ring-[#ea580c] border-gray-300" name="payment" type="radio"/>
<span class="text-[#181311] font-bold">Razorpay</span>
</label>
              <label class="flex items-center gap-2 cursor-pointer border border-[#f4f1f0] rounded-lg p-3 w-1/2 has-[:checked]:border-[#ea580c] has-[:checked]:bg-[#fff7ed] transition-all">
                <input checked class="w-4 h-4 text-[#ea580c] focus:ring-[#ea580c] border-gray-300" name="payment" type="radio"/>
                <span class="text-[#181311] font-medium">Cash on delivery</span>
              </label>

            </div>
          </div>
        </section> -->
      <section>
  <div class="flex items-center gap-3 mb-6">
    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-[#181311] text-white font-bold text-sm">2</div>
    <h2 class="text-[#181311] text-xl font-bold">Payment Method</h2>
  </div>

  <div class="flex gap-3 flex-wrap mb-4">

    <!-- Razorpay (includes UPI, Cards, Net Banking) -->
    <label class="flex items-center gap-3 cursor-pointer border rounded-xl p-4 flex-1 transition-all has-[:checked]:border-[#ea580c] has-[:checked]:bg-[#fff7ed] border-[#f4f1f0]">
      <input class="w-5 h-5 text-[#ea580c] focus:ring-[#ea580c]"
             name="payment" type="radio" value="razorpay" checked
             onchange="handlePaymentChange(this.value)" />
      <div>
        <p class="text-[#181311] font-bold text-sm">Online Payment</p>
        <p class="text-[#886e63] text-xs">UPI · Cards · Net Banking · Wallets</p>
      </div>
    </label>

    <!-- Cash on Delivery -->
    <label class="flex items-center gap-3 cursor-pointer border rounded-xl p-4 flex-1 transition-all has-[:checked]:border-[#ea580c] has-[:checked]:bg-[#fff7ed] border-[#f4f1f0]">
      <input class="w-5 h-5 text-[#ea580c] focus:ring-[#ea580c]"
             name="payment" type="radio" value="cod"
             onchange="handlePaymentChange(this.value)" />
      <div>
        <p class="text-[#181311] font-bold text-sm">Cash on Delivery</p>
        <p class="text-[#886e63] text-xs">Pay when your order arrives</p>
      </div>
    </label>

  </div>

  <!-- Pay Now Button -->
  <div id="razorpay-section">
    <button onclick="payWithRazorpay()"
      class="w-full bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold py-3 px-6 rounded-xl transition-all flex items-center justify-center gap-2">
      <span class="material-symbols-outlined text-base">payments</span>
      Pay ₹<%= total.toFixed(2) %>
    </button>
  </div>

  <!-- COD Button -->
  <div id="cod-section" class="hidden">
    <button onclick="placeOrderCOD()"
      class="w-full bg-[#181311] hover:bg-[#2d2520] text-white font-bold py-3 px-6 rounded-xl transition-all flex items-center justify-center gap-2">
      <span class="material-symbols-outlined text-base">local_shipping</span>
      Place Order (Cash on Delivery)
    </button>
  </div>
</section>



      </div>

      <!-- ══════════ ORDER SUMMARY ══════════ -->
      <div class="w-full lg:w-[400px] shrink-0 relative">
        <div class="sticky top-6 rounded-2xl bg-[#f9f8f8] p-6 border border-[#f4f1f0]">
          <h3 class="text-[#181311] text-lg font-bold mb-6">Order Summary</h3>

          <div class="flex flex-col gap-4 mb-6 max-h-[300px] overflow-y-auto pr-2">
            <% if (cartItems && cartItems.length > 0) { %>
              <% cartItems.forEach(item => {
                const variant = item.productId.variants.find(v =>
                  v._id.toString() === item.variantId?.toString()
                );
                const price = variant ? variant.price : 0;
              %>
              <div class="flex gap-3 items-center">
                <div class="w-16 h-16 rounded-lg bg-cover bg-center shrink-0 border border-[#f4f1f0]"
                  style='background-image: url("/uploads/product/<%= item.productId.images[0] %>");'>
                </div>
                <div class="flex-1">
                  <p class="text-[#181311] font-medium text-sm"><%= item.productId.name %></p>
                  <p class="text-[#886e63] text-xs">Qty: <%= item.quantity %></p>
                </div>
                <p class="text-[#181311] font-bold text-sm">₹ <%= (price * item.quantity).toFixed(2) %></p>
              </div>
              <% }) %>
            <% } else { %>
              <p class="text-center text-sm text-[#886e63]">No items in cart</p>
            <% } %>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex justify-between text-sm">
              <span class="text-[#886e63]">Subtotal</span>
              <span class="text-[#181311] font-medium">₹ <%= subtotal.toFixed(2) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-[#886e63]">Shipping</span>
              <span class="text-[#181311] font-medium">₹ <%= shipping %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-[#886e63]">Estimated Taxes</span>
              <span class="text-[#181311] font-medium">₹ <%= tax.toFixed(2) %></span>
            </div>
            <div class="flex justify-between text-lg font-bold mt-2 pt-4 border-t border-[#e5e7eb]">
              <span class="text-[#181311]">Total</span>
              <span class="text-[#ea580c]">₹ <%= total.toFixed(2) %></span>
            </div>
          </div>
          <button onclick="placeOrder()"
            class="w-full mt-6 bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold py-4 rounded-xl shadow-sm transition-colors text-base flex items-center justify-center gap-2">
            <span>Place Order</span>
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </button>

          <p class="text-[#886e63] text-xs text-center mt-4 flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-sm">lock</span> Secure Checkout
          </p>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include("../partials/footer") %>
</div>
</div>

<script>
let selectedId = "<%= addresses && addresses.length ? (addresses.find(a => a.isdefault)?._id || addresses[0]._id) : '' %>";
let editingAddressId = null;

// ── SELECT ADDRESS ───────────────────────────────────────────
function selectAddress(id) {
  selectedId = id;
  document.querySelectorAll('.addr-card').forEach(c => c.classList.remove('selected'));
  document.querySelector(`[data-id="${id}"]`)?.classList.add('selected');
}

// ── OPEN ADD FORM ────────────────────────────────────────────
function openAddForm() {
  editingAddressId = null;
  document.getElementById('form-title').textContent = 'New Shipping Address';
  clearForm();
  clearAllErrors();
  openForm();
}

// ── OPEN EDIT FORM ───────────────────────────────────────────
function openEditForm(id) {
  editingAddressId = id;
  const card = document.querySelector(`[data-id="${id}"]`);
  if (!card) return;

  document.getElementById('form-title').textContent   = 'Edit Address';
  document.getElementById('inp-name').value           = card.dataset.name       || '';
  document.getElementById('inp-address').value        = card.dataset.address    || '';
  document.getElementById('inp-appartment').value     = card.dataset.appartment || '';
  document.getElementById('inp-city').value           = card.dataset.city       || '';
  document.getElementById('inp-state').value          = card.dataset.state      || '';
  document.getElementById('inp-zip').value            = card.dataset.zip        || '';
  document.getElementById('inp-phone').value          = card.dataset.phone      || '';

  clearAllErrors();
  openForm();
}

// ── VALIDATION RULES ─────────────────────────────────────────
// Each rule: { test: fn(val) => bool, msg: string }
const RULES = {
  'inp-name':       { test: v => /^[a-zA-Z\s]{3,}$/.test(v),   msg: 'Enter a valid full name (min 3 letters).' },
  'inp-address':    { test: v => v.length >= 5,                  msg: 'Address must be at least 5 characters.' },
  'inp-appartment': { test: v => v.length >= 1,                  msg: 'Apartment / Flat No. is required.' },
  'inp-city':       { test: v => /^[a-zA-Z\s]{2,}$/.test(v),   msg: 'Enter a valid city name.' },
  'inp-state':      { test: v => /^[a-zA-Z\s]{2,}$/.test(v),   msg: 'Enter a valid state name.' },
  'inp-zip':        { test: v => /^\d{6}$/.test(v),              msg: 'Enter a valid 6-digit zip code.' },
  'inp-phone':      { test: v => /^[6-9]\d{9}$/.test(v),        msg: 'Enter a valid 10-digit mobile number.' },
};

// Validate a single field; only show green border after blur (touched)
function validateOne(inputId, { force = false } = {}) {
  const rule  = RULES[inputId];
  if (!rule) return true;

  const input = document.getElementById(inputId);
  const error = document.getElementById('err-' + inputId.replace('inp-', ''));
  const val   = input.value.trim();
  const pass  = val !== '' && rule.test(val);

  // Update error message dynamically
  const icon = `<span class="material-symbols-outlined" style="font-size:13px">error</span>`;
  if (!val) {
    const label = input.closest('div').querySelector('label')?.textContent?.trim() || 'This field';
    error.innerHTML = icon + ` ${label} is required.`;
  } else if (!pass) {
    error.innerHTML = icon + ` ${rule.msg}`;
  }

  const touched = force || input.classList.contains('touched');

  if (!pass) {
    input.classList.add('invalid');
    input.classList.remove('valid');
    if (touched) error.classList.add('visible');
    return false;
  } else {
    input.classList.remove('invalid');
    error.classList.remove('visible');
    if (touched) input.classList.add('valid');
    return true;
  }
}

function markTouched(input) {
  input.classList.add('touched');
  validateOne(input.id, { force: true });
}

// Wire up live feedback (oninput) — only shows error after field is touched
function liveValidate(inputId) {
  validateOne(inputId);
}

function showError(input, errorEl) {
  input.classList.remove('valid');
  input.classList.add('invalid', 'touched');
  errorEl.classList.add('visible');
}

function clearError(input, errorEl) {
  input.classList.remove('invalid');
  input.classList.add('valid', 'touched');
  errorEl.classList.remove('visible');
}

function clearAllErrors() {
  Object.keys(RULES).forEach(inputId => {
    const input = document.getElementById(inputId);
    const errId = 'err-' + inputId.replace('inp-', '');
    const error = document.getElementById(errId);
    if (input && error) {
      input.classList.remove('invalid', 'valid', 'touched');
      error.classList.remove('visible');
    }
  });
}

// ── SAVE ADDRESS (ADD or EDIT) ───────────────────────────────
async function saveAddress() {
  // Force-validate all fields (mark all as touched)
  const results = Object.keys(RULES).map(id => validateOne(id, { force: true }));

  // Also mark all as touched so borders show
  Object.keys(RULES).forEach(id => document.getElementById(id)?.classList.add('touched'));

  if (results.includes(false)) {
    const firstInvalid = document.querySelector('input.invalid');
    if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }

  const fullname    = document.getElementById('inp-name').value.trim();
  const address     = document.getElementById('inp-address').value.trim();
  const appartment  = document.getElementById('inp-appartment').value.trim();
  const city        = document.getElementById('inp-city').value.trim();
  const state       = document.getElementById('inp-state').value.trim();
  const zipcode     = document.getElementById('inp-zip').value.trim();
  const phonenumber = document.getElementById('inp-phone').value.trim();

  const isEdit = !!editingAddressId;
  const url    = isEdit ? `/address/edit/${editingAddressId}` : '/address/add';
  const method = isEdit ? 'PUT' : 'POST';

  const saveBtn = document.getElementById('save-btn');
  saveBtn.disabled = true;
  saveBtn.innerHTML = `<span class="material-symbols-outlined text-base">progress_activity</span> Saving...`;

  try {
    const res  = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ fullname, address, appartment, city, state, zipcode, phonenumber })
    });
    const data = await res.json();

    if (data.success) {
      closeForm();
      location.reload();
    } else {
      alert(data.message || 'Failed to save address');
      resetSaveBtn();
    }
  } catch (err) {
    console.error(err);
    alert('Something went wrong');
    resetSaveBtn();
  }
}

// ── PLACE ORDER ──────────────────────────────────────────────
async function placeOrder() {
  if (!selectedId) {
    alert("Please select a delivery address");
    return;
  }

  try {
    const res  = await fetch("/place-order", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ addressId: selectedId })
    });

    const data = await res.json();

    if (data.success) {
      window.location.href = "/ordersuccess";
    } else {
      alert(data.message || "Order failed. Please try again.");
    }
  } catch (err) {
    console.error("Place order error:", err);
    alert("Something went wrong. Please try again.");
  }
}

// ── HELPERS ──────────────────────────────────────────────────
function openForm()  { document.getElementById('address-form-wrapper').classList.add('open'); }
function closeForm() {
  document.getElementById('address-form-wrapper').classList.remove('open');
  clearAllErrors();
}

function clearForm() {
  ['inp-name','inp-address','inp-appartment','inp-city','inp-state','inp-zip','inp-phone']
    .forEach(id => document.getElementById(id).value = '');
}

function resetSaveBtn() {
  const btn = document.getElementById('save-btn');
  btn.disabled = false;
  btn.innerHTML = `<span class="material-symbols-outlined text-base">save</span> Save Address`;
}

document.addEventListener("DOMContentLoaded", () => {
  if (selectedId) {
    document.querySelector(`[data-id="${selectedId}"]`)?.classList.add('selected');
  }
});
</script>

