<script>
  function togglePassword(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === "password") {
      input.type = "text";
      icon.textContent = "visibility_off";
    } else {
      input.type = "password";
      icon.textContent = "visibility";
    }
  }
</script>
<script>
const form = document.getElementById("signupForm");

const fullnameInput = document.getElementById("full_name");
const emailInput = document.getElementById("email");
const passwordInput = document.getElementById("password");
const confirmPasswordInput = document.getElementById("confirm_password");
const termsInput = document.getElementById("terms");

// ===============================
// Show Error Function
// ===============================
function showError(input, id, message) {
    const errorElement = document.getElementById(id);
    errorElement.textContent = message;
    errorElement.classList.remove("hidden");
    input.classList.add("border-red-500");
}

// ===============================
// Clear Error
// ===============================
function clearError(input, id) {
    const errorElement = document.getElementById(id);
    errorElement.textContent = "";
    errorElement.classList.add("hidden");
    input.classList.remove("border-red-500");
}

// ===============================
// Real-time Validation
// ===============================
fullnameInput.addEventListener("input", () => {
    if (fullnameInput.value.trim().length < 3) {
        showError(fullnameInput, "fullnameError",
            "Full name must be at least 3 characters.");
    } else {
        clearError(fullnameInput, "fullnameError");
    }
});

emailInput.addEventListener("input", () => {
    const emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,}$/;
    if (!emailPattern.test(emailInput.value.trim())) {
        showError(emailInput, "emailError",
            "Enter a valid email address.");
    } else {
        clearError(emailInput, "emailError");
    }
});

passwordInput.addEventListener("input", () => {
    const strongPassword = /^(?=.*[A-Z])(?=.*[0-9]).{8,}$/;
    if (!strongPassword.test(passwordInput.value)) {
        showError(passwordInput, "passwordError",
            "Min 8 chars, 1 uppercase & 1 number.");
    } else {
        clearError(passwordInput, "passwordError");
    }
});

confirmPasswordInput.addEventListener("input", () => {
    if (passwordInput.value !== confirmPasswordInput.value) {
        showError(confirmPasswordInput, "confirmPasswordError",
            "Passwords do not match.");
    } else {
        clearError(confirmPasswordInput, "confirmPasswordError");
    }
});

// ===============================
// Final Submit Validation
// ===============================
form.addEventListener("submit", function(e) {
    let isValid = true;

    if (fullnameInput.value.trim().length < 3) {
        isValid = false;
    }

    const emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,}$/;
    if (!emailPattern.test(emailInput.value.trim())) {
        isValid = false;
    }

    const strongPassword = /^(?=.*[A-Z])(?=.*[0-9]).{8,}$/;
    if (!strongPassword.test(passwordInput.value)) {
        isValid = false;
    }

    if (passwordInput.value !== confirmPasswordInput.value) {
        isValid = false;
    }

    if (!termsInput.checked) {
        document.getElementById("termsError").textContent =
            "You must accept the terms.";
        document.getElementById("termsError").classList.remove("hidden");
        isValid = false;
    }

    if (!isValid) {
        e.preventDefault();
    }
});
</script>
<% if (typeof error !== "undefined" || typeof success !== "undefined") { %>

<div id="toast"
     class="fixed bottom-6 right-6 
     <%= error ? 'bg-red-600' : 'bg-green-600' %> 
     text-white px-8 py-4 rounded-xl shadow-2xl text-base font-medium
     transform translate-y-20 opacity-0 transition-all duration-500">

  <%= error || success %>

</div>

<script>
  const toast = document.getElementById("toast");

  // Show animation
  setTimeout(() => {
    toast.classList.remove("translate-y-20", "opacity-0");
  }, 100);

  // Hide after 3 seconds
  setTimeout(() => {
    toast.classList.add("translate-y-20", "opacity-0");
  }, 3000);
</script>

<% } %>  



