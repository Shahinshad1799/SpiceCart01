<% if (typeof error !== "undefined") { %>
<div id="toast"
     class="fixed bottom-6 right-6 bg-red-600 text-white px-8 py-4 rounded-xl shadow-2xl text-base font-medium
            transform translate-y-20 opacity-0 transition-all duration-500">
  <%= error %>
</div>

<script>
  const toas = document.getElementById("toast");

  setTimeout(() => {
    toas.classList.remove("translate-y-20", "opacity-0");
  }, 100);

  setTimeout(() => {
    toas.classList.add("translate-y-20", "opacity-0");
  }, 3000);
</script>
<% } %>



<script>
const timerText = document.getElementById("timerText");
const resendBtn = document.getElementById("resendBtn");

// -----------------------------
// 1️⃣ Initialize from server
// otpExpiry is passed from your controller: res.render("otpPage", { otpExpiry })
// otpExpiry is timestamp in ms
const otpDataDiv = document.getElementById("otp-data");
let otpExpiryFromServer = Number(otpDataDiv.dataset.expiry) || Date.now();
  console.log("OTP expiry:", otpExpiryFromServer);
let countdown;

// Calculate remaining seconds
function getTimeLeft() {
    return Math.max(Math.floor((otpExpiryFromServer - Date.now()) / 1000), 0);
}

// -----------------------------
// 2️⃣ Timer update function
function updateTimer() {
    const timeLeft = getTimeLeft();

    if (timeLeft <= 0) {
        clearInterval(countdown);
        resendBtn.disabled = false; // enable resend button
        timerText.textContent = "";
        return;
    }

    const minutes = Math.floor(timeLeft / 60);
    const seconds = timeLeft % 60;

    timerText.textContent = `(${minutes}:${seconds.toString().padStart(2, "0")})`;
}

// -----------------------------
// 3️⃣ Start / restart timer
function startTimer() {
    resendBtn.disabled = true;
    clearInterval(countdown);
    updateTimer();
    countdown = setInterval(updateTimer, 1000);
}

// Start timer on page load if OTP is still valid
if (getTimeLeft() > 0) startTimer();
else resendBtn.disabled = false;

// -----------------------------
// 4️⃣ Resend OTP logic
resendBtn.addEventListener("click", async function () {
    resendBtn.disabled = true;

    try {
        const res = await fetch("/resendotp", { method: "POST" });
        const data = await res.json();

        if (data.success) {

            await Swal.fire({
                icon: "success",
                title: "OTP Sent",
                text: "New OTP has been sent to your email.",
                timer: 2000,
                showConfirmButton: false
            });

            // Update server-provided expiry
            otpExpiryFromServer = data.otpExpiry;

            // Restart countdown
            startTimer();

        } else {

            Swal.fire({
                icon: "error",
                title: "Failed",
                text: "Failed to resend OTP. Please try again."
            });

            resendBtn.disabled = false;
        }

    } catch (err) {

        console.log("Fetch Error:", err);

        Swal.fire({
            icon: "error",
            title: "Network Error",
            text: "Error sending OTP. Check your connection."
        });

        resendBtn.disabled = false;
    }
});
</script>

