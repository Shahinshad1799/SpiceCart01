<h2 class="text-2xl lg:text-3xl font-bold tracking-tight text-[#181311] dark:text-white">Spice Market</h2>
</div>
</div>
<main class="flex-1 flex items-start justify-center pb-12 px-6 lg:px-20 xl:px-40">
<div class="flex w-full max-w-[1080px] bg-white dark:bg-[#2C201A] rounded-2xl overflow-hidden shadow-2xl border border-[#f4f1f0] dark:border-[#3E302A]">
<div class="w-full lg:w-1/2 p-8 sm:p-12 xl:p-16 flex flex-col justify-center">
<div class="mb-8">
<h1 class="text-3xl font-bold text-[#181311] dark:text-white mb-2">Verify Your Account</h1>
<p class="text-[#886e63] dark:text-[#9CA3AF] font-body">A 6-digit code has been sent to your email address.</p>
</div>
<form class="space-y-6" method="post" action="/otpverification">
<div class="space-y-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white" for="verification_code">Verification Code</label>
<input class="w-full h-14 rounded-lg bg-[#f4f1f0] dark:bg-[#1A120E] border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#211611] focus:ring-0 transition-colors text-[#181311] dark:text-white px-4 placeholder-[#886e63]/30 text-center text-2xl tracking-[0.5em] font-display font-bold" id="verification_code" inputmode="numeric" maxlength="6" name="otp" placeholder="000000" type="text"/>
 <input type="hidden" name="purpose" value="<%= purpose %>">
</div>
<button class="w-full h-12 bg-primary hover:bg-primary/90 text-white font-bold rounded-lg transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center justify-center gap-2 mt-2">
                            Verify
                            <span class="material-symbols-outlined text-[20px]">check_circle</span>
</button>
</form>
<div class="mt-8 text-center">
<p class="text-sm text-[#5C4D46] dark:text-[#A8A29E] font-body">
    Didn't receive the code?
    
    <button 
        id="resendBtn"
        class="text-primary font-bold hover:underline ml-1 opacity-50 cursor-not-allowed"
        disabled>
        Resend Code (<span id="timer">02:00</span>)
    </button>
</p>



</div>
</div>
<div class="hidden lg:block w-1/2 relative bg-[#f4f1f0] dark:bg-[#1A120E]">
<img alt="Spices" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB57wCUrHqr1bJmfsAcPDN36yftPiNGg_lN0dXp5CwzuwTN2q9nXcYjuDAD8U8jw-mb-HqA7c_5aaTAk-jWY4fuJ8xk1vlZEIt2TS52byXQ-bstINyZRG86-YLqnPCBjrce9UpzfHWeouglKIqmIYqlRLWK-TF6tFN9h6ONx2u656HR6hQ431otQgZ5zNb2uqszjnmIeuVc9-HhhnmyjiVN0jRlR9M999Pxj30WMGYPKn-ii-cIClGUGza5nhp2nchgI8nHOS0OIpU"/>
<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80"></div>
<div class="absolute bottom-0 left-0 w-full p-12 text-white">
<div class="bg-white/20 backdrop-blur-md rounded-xl p-6 border border-white/10 animate-bounce-slow">
<span class="material-symbols-outlined text-4xl text-primary mb-4">eco</span>
<h3 class="text-2xl font-bold mb-2">Taste the Authentic</h3>
<p class="text-white/80 font-body">"The freshness of these spices completely transformed my cooking. I'll never go back to supermarket brands."</p>
<div class="flex items-center gap-2 mt-4">
<div class="flex text-secondary text-sm">
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
<span class="material-symbols-outlined fill-current text-[18px]" style="font-variation-settings: 'FILL' 1">star</span>
</div>
<span class="text-xs font-bold text-white uppercase tracking-wider">• Trusted by 10k+ Chefs</span>
</div>
</div>
</div>
</div>
</div>
</main>
<footer class="py-8 text-center text-sm text-[#886e63] dark:text-[#9CA3AF]">
<div class="flex flex-col items-center gap-4">
<p>© 2024 Spice Market. All rights reserved.</p>
<div class="flex gap-6 text-xs">
<a class="hover:text-primary transition-colors" href="#">Privacy Policy</a>
<a class="hover:text-primary transition-colors" href="#">Terms of Service</a>
<a class="hover:text-primary transition-colors" href="#">Help Center</a>
</div>
</div>
</footer>
</div>
<script>
    let timeLeft = 120; // 2 minutes in seconds
    const timerElement = document.getElementById("timer");
    const resendBtn = document.getElementById("resendBtn");

    const countdown = setInterval(() => {
        let minutes = Math.floor(timeLeft / 60);
        let seconds = timeLeft % 60;

        seconds = seconds < 10 ? "0" + seconds : seconds;
        timerElement.textContent = `${minutes}:${seconds}`;

        if (timeLeft <= 0) {
            clearInterval(countdown);
            resendBtn.disabled = false;
            resendBtn.classList.remove("opacity-50", "cursor-not-allowed");
            resendBtn.innerHTML = "Resend Code";
        }

        timeLeft--;
    }, 1000);

    resendBtn.addEventListener("click", function () {
        fetch("/resend-otp", {
            method: "POST"
        })
        .then(res => res.json())
        .then(data => {
            alert("OTP Resent Successfully");

            // Restart timer
            timeLeft = 120;
            resendBtn.disabled = true;
            resendBtn.classList.add("opacity-50", "cursor-not-allowed");
            resendBtn.innerHTML = `Resend Code (<span id="timer">02:00</span>)`;

            // Restart countdown
            location.reload(); // simplest method
        })
        .catch(err => console.log(err));
    });
</script>
</body></html>