<!DOCTYPE html>
<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Spice Market - Edit Profile</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&amp;family=Manrope:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#cd4e18",
                        "background-light": "#f8f6f6",
                        "background-dark": "#211611",
                        "secondary": "#B89F73", // Muted Gold for stars
                        "forest": "#4C5E4E", // Forest Green for accents
                        "muted-green": "#F0F3F1", // Soft muted background
                    },
                    fontFamily: {
                        "display": ["Epilogue", "sans-serif"],
                        "body": ["Manrope", "sans-serif"],
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem", 
                        "lg": "0.5rem", 
                        "xl": "0.75rem", 
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark font-display text-[#181311] dark:text-[#f4f1f0] antialiased overflow-x-hidden">
<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root">
<%- include("../partials/header", { title: "editProfile" }) %>
<main class="flex-1 bg-muted-green dark:bg-[#1A120E]">
<section class="px-6 py-10 lg:px-20 xl:px-40 min-h-[calc(100vh-80px)]">
<div class="mx-auto max-w-[1280px]">
<div class="mb-8 flex items-center gap-2 text-sm text-[#886e63] dark:text-[#9CA3AF]">
<a class="hover:text-primary" href="#">Home</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<a class="hover:text-primary" href="/profile">Account</a>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-[#181311] dark:text-white font-medium">Edit Profile</span>
</div>
<div class="w-full max-w-4xl mx-auto">
<div class="bg-white dark:bg-[#2C201A] rounded-2xl shadow-sm border border-[#E6E0DC] dark:border-[#3E302A] overflow-hidden">
<div class="px-6 py-6 lg:px-8 border-b border-[#f4f1f0] dark:border-[#3E302A]">
<h1 class="text-2xl font-bold text-[#181311] dark:text-white mb-6">Account Details</h1>
<div class="flex flex-wrap gap-2 overflow-x-auto no-scrollbar pb-1">
<button class="px-5 py-2 rounded-full bg-primary text-white text-sm font-bold shadow-md shadow-primary/20 transition-all">Details</button>
<a href="/address">
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Address</button>

</a>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Order</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Wallet</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">Referral</button>
<button class="px-5 py-2 rounded-full bg-transparent hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] text-[#5C4D46] dark:text-[#A8A29E] text-sm font-medium transition-colors">FAQ</button>
</div>
</div>
<div class="p-6 lg:p-8">
<div class="mb-10 pb-8 border-b border-[#f4f1f0] dark:border-[#3E302A]">
<h2 class="text-lg font-bold text-[#181311] dark:text-white mb-6">Profile Picture</h2>
<div class="flex flex-col sm:flex-row sm:items-center gap-6">
<div class="relative size-24 rounded-full overflow-hidden border-2 border-[#E6E0DC] dark:border-[#3E302A] shrink-0">
  <img
    id="imagePreview"
    alt="User"
    class="w-full h-full object-cover"
    src="<%= user.profileImage 
      ? '/uploads/profile/' + user.profileImage 
      : '/images/default.png' %>"
  />
</div>

<div class="flex flex-col gap-3">
<div class="flex flex-wrap items-center gap-3">
<!-- Hidden File Input -->
 <form class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-8"
      action="/editprofile"
      method="POST"
      enctype="multipart/form-data">
    

<input type="file"
       name="profileImage"
       id="profileImageInput"
       class="hidden"
       accept="image/*"
       onchange="previewImage(event)">

<!-- Upload Button -->
<button type="button"
        onclick="document.getElementById('profileImageInput').click()"
        class="px-5 py-2.5 rounded-lg bg-[#181311] dark:bg-white text-white dark:text-[#181311] text-sm font-bold hover:opacity-90 transition-all shadow-sm flex items-center gap-2">
  <span class="material-symbols-outlined text-sm">upload</span>
  Upload New Picture
</button>

<button type="button"
        onclick="confirmDelete()"
        class="px-5 py-2.5 rounded-lg border border-[#E6E0DC] 
               dark:border-[#3E302A] text-[#5C4D46] 
               dark:text-[#A8A29E] text-sm font-bold 
               hover:bg-[#f4f1f0] dark:hover:bg-[#3E302A] 
               hover:text-[#cd4e18] transition-colors">
  Delete
</button>
</div>
</div>
</div>

<div class="col-span-1 md:col-span-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Full Name</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">person</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium" type="text" name="fullname" value="<%= user.fullname %>"/>
<p class="error-msg text-red-500 text-sm mt-1 
  <%= error?.fullname ? '' : 'hidden' %>" 
  id="fullnameError">
  <%= error?.fullname %>
</p></div>
</div>
<p class="error-msg text-red-500 text-sm mt-1 
  <%= error?.fullname ? '' : 'hidden' %>" 
  id="fullnameError">
  <%= error?.fullname %>
</p>
<div class="col-span-1">
  <div class="flex justify-between items-center mb-2">
    <label class="block text-sm font-bold text-[#181311] dark:text-white">
      Email Address
    </label>

    <!-- Change Email Button -->
     <a href="/changeemail">
  <button type="button"
      class="text-xs font-bold text-primary hover:underline hover:text-primary/80 transition-colors">
      Change Email
    </button>
     </a>
  
  </div>

  <div class="relative group">
    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63]">
      mail
    </span>

    <!-- Disabled Email Input -->
    <input
      id="emailDisplay"
      class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611]
             border border-transparent text-[#181311] dark:text-white
             font-medium opacity-70 cursor-not-allowed"
      type="email"
      value="<%= user.email %>"
      disabled
    />
  </div>
</div>
<div class="col-span-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Phone Number</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">call</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium" type="tel" name="phonenumber" value="<%= user.phonenumber %>"/>
<p class="error-msg text-red-500 text-sm mt-1 
  <%= error?.phonenumber ? '' : 'hidden' %>" 
  id="phoneError">
  <%= error?.phonenumber %>
</p></div>
</div>

<div class="col-span-1">
<label class="block text-sm font-bold text-[#181311] dark:text-white mb-2">Date of Birth</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">calendar_month</span>
<input
  class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611]
         border-transparent focus:border-primary focus:bg-white
         dark:focus:bg-[#2C201A] focus:ring-0 transition-all
         text-[#181311] dark:text-white font-medium"
  type="date"
  name="dateofbirth"
value="<%= user.dateofbirth 
  ? new Date(user.dateofbirth).toISOString().split('T')[0] 
  : '' %>"/>
<p class="error-msg text-red-500 text-sm mt-1 hidden" id="dobError"></p>
</div>
</div>
<div class="col-span-1">
<div class="flex justify-between items-center mb-2">
<label class="block text-sm font-bold text-[#181311] dark:text-white">Password</label>
<a class="text-xs font-bold text-primary hover:underline hover:text-primary/80 transition-colors" href="/changepassword">Change Password</a>
</div>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#886e63] transition-colors group-focus-within:text-primary">lock</span>
<input class="w-full h-12 pl-12 pr-4 rounded-lg bg-[#f8f6f6] dark:bg-[#211611] border border-transparent focus:border-primary focus:bg-white dark:focus:bg-[#2C201A] focus:ring-0 transition-all text-[#181311] dark:text-white placeholder-[#886e63] font-medium tracking-widest" type="password" value="Password123"/>
</div>
</div>
<div class="col-span-1 md:col-span-2 pt-6 flex justify-end border-t border-[#f4f1f0] dark:border-[#3E302A] mt-2">
<button class="h-12 px-8 rounded-lg bg-primary hover:bg-primary/90 text-white font-bold transition-transform active:scale-95 shadow-lg shadow-primary/30 flex items-center gap-2" type="submit">
<span class="material-symbols-outlined">check_circle</span>
                                            Update Profile
                                        </button>
</div>
</form>
</div>
</div>
</div>
</div>
</section>
</main>
<%- include("../partials/footer") %>
</div>
<script>
function previewImage(event) {
  const reader = new FileReader();
  reader.onload = function () {
    document.getElementById("imagePreview").src = reader.result;
  };
  reader.readAsDataURL(event.target.files[0]);
}
</script>
<script>
const form = document.querySelector("form");
const fullname = document.querySelector("input[name='fullname']");
const phone = document.querySelector("input[name='phonenumber']");
const dob = document.querySelector("input[name='dateofbirth']");
const imageInput = document.getElementById("profileImageInput");

// ===== Helper Functions =====
function showError(id, message, input) {
  const el = document.getElementById(id);
  el.textContent = message;
  el.classList.remove("hidden");
  input.classList.add("border-red-500");
}

function clearError(id, input) {
  const el = document.getElementById(id);
  el.textContent = "";
  el.classList.add("hidden");
  input.classList.remove("border-red-500");
}

// ===== Real-time Validation =====

// Fullname
fullname.addEventListener("input", () => {
  const namePattern = /^[A-Za-z ]{3,}$/;
  if (!namePattern.test(fullname.value.trim())) {
    showError("fullnameError", "Enter valid name (min 3 letters).", fullname);
  } else {
    clearError("fullnameError", fullname);
  }
});


// Phone
phone.addEventListener("input", () => {
  const phonePattern = /^[0-9]{10}$/;
  if (!phonePattern.test(phone.value.trim())) {
    showError("phoneError", "Phone must be 10 digits.", phone);
  } else {
    clearError("phoneError", phone);
  }
});

// Date of Birth (18+ validation)
dob.addEventListener("change", () => {
  const birthDate = new Date(dob.value);
  const today = new Date();
  const age = today.getFullYear() - birthDate.getFullYear();

  if (!dob.value) {
    showError("dobError", "Select your date of birth.", dob);
  } else if (age < 18) {
    showError("dobError", "You must be at least 18 years old.", dob);
  } else {
    clearError("dobError", dob);
  }
});

// Image validation
imageInput.addEventListener("change", () => {
  const file = imageInput.files[0];
  if (!file) return;

  const allowedTypes = ["image/jpeg", "image/png", "image/gif"];
  const maxSize = 10 * 1024 * 1024; // 10MB

  if (!allowedTypes.includes(file.type)) {
    alert("Only JPG, PNG, GIF allowed.");
    imageInput.value = "";
  }

  if (file.size > maxSize) {
    alert("Image must be less than 10MB.");
    imageInput.value = "";
  }
});

// ===== Final Submit Check =====
form.addEventListener("submit", (e) => {
  let isValid = true;

  // Fullname
  if (fullname.value.trim().length < 3) {
    isValid = false;
  }

  // Email
  if (!/^[^ ]+@[^ ]+\.[a-z]{2,}$/.test(email.value.trim())) {
    isValid = false;
  }

  // Phone
  if (!/^[0-9]{10}$/.test(phone.value.trim())) {
    isValid = false;
  }

  // DOB (18+ validation)
  if (!dob.value) {
    isValid = false;
  } else {
    const birthDate = new Date(dob.value);
    const today = new Date();

    let age = today.getFullYear() - birthDate.getFullYear();
    const monthDiff = today.getMonth() - birthDate.getMonth();

    if (
      monthDiff < 0 ||
      (monthDiff === 0 && today.getDate() < birthDate.getDate())
    ) {
      age--;
    }

    if (age < 18) {
      isValid = false;
    }
  }

  if (!isValid) {
    e.preventDefault();
  }
});
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body></html>